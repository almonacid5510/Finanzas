    <SolidColorBrush x:Key="Fondo" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="Tarjeta" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Borde" Color="#E3E7EE"/>
    <SolidColorBrush x:Key="BordeInput" Color="#D5DBE4"/>
