    <!-- Plantilla del control Icono (ver Controles/Icono.cs) -->
    <Style TargetType="c:Icono">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Icono">
                    <Viewbox Width="{TemplateBinding Tamano}" Height="{TemplateBinding Tamano}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Geometria}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding Grosor}" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TEXTOS ==================== -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <Style x:Key="SubtituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>
    <!-- Título de tarjeta ("¿A dónde va tu ingreso?") -->
    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <!-- Etiqueta de sección en mayúsculas ("SALDO QUE DEBES") -->
    <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
    </Style>
    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
    </Style>
    <!-- Cifra grande de un indicador -->
    <Style x:Key="CifraKpi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>

    <!-- Etiqueta de campo de formulario ("Descripción") -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Margin" Value="1,0,0,5"/>
    </Style>
    <!-- Label asociado a su campo (Target): lo anuncian los lectores de pantalla -->
    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Padding" Value="1,0,0,5"/>
    </Style>

    <!-- Nombres anteriores -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TituloPagina}"/>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource TituloTarjeta}"/>

    <!-- ==================== CAMPO DE TEXTO ==================== -->
    <Style x:Key="ModernInput" TargetType="TextBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeInput}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <Grid>
                            <!-- Texto de ejemplo cuando el campo está vacío (c:Ui.Pista) -->
                            <TextBlock x:Name="pista" Text="{Binding (c:Ui.Pista), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource GrisPista}" Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <!-- Sin Margin: el TextBox ya aplica su Padding al texto -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="pista" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#AEB8C6"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernInputNumeric" TargetType="TextBox" BasedOn="{StaticResource ModernInput}">
        <Setter Property="MaxLength" Value="17"/>
    </Style>

    <!-- Campo compacto dentro de tarjetas y filas editables -->
    <Style x:Key="EditInput" TargetType="TextBox" BasedOn="{StaticResource ModernInput}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MaxLength" Value="17"/>
    </Style>

    <!-- Visible solo en modo edición (el DataContext expone 'Editando') -->
    <Style x:Key="EditInputInline" TargetType="TextBox" BasedOn="{StaticResource EditInput}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Editando}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== LISTA DESPLEGABLE ==================== -->
    <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AzulSuave}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModernComboToggle" TargetType="ToggleButton">
        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BordeInput}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <c:Icono Grid.Column="1" Geometria="{StaticResource IcoAbajo}" Tamano="14" Foreground="{StaticResource Texto2}"
                         HorizontalAlignment="Left"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#AEB8C6"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ModernComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!-- Texto de ejemplo cuando no hay nada elegido -->
                        <TextBlock x:Name="pista" Text="{Binding (c:Ui.Pista), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource GrisPista}" Margin="12,0,30,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <!-- Solo con IsEditable="True": permite escribir un valor nuevo -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                 Margin="10,0,30,0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                            <Border Background="White" CornerRadius="9" Margin="0,4,0,8"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    BorderBrush="{StaticResource Borde}" BorderThickness="1" Padding="0,4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="3"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="pista" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="pista" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== FECHA ==================== -->
    <Style x:Key="CalendarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7" Width="30" Height="30">
                        <c:Icono Geometria="{StaticResource IcoCalendario}" Tamano="15" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource GrisSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickerTextBoxStyle" TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeInput}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="pista" Text="dd/mm/aaaa" Foreground="{StaticResource GrisPista}" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBoxStyle}"
                                               BorderThickness="0" Background="Transparent"
                                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource CalendarButtonStyle}"
                                    Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="SelectedDate" Value="{x:Null}"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="pista" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource Azul}"/>
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#AEB8C6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BOTONES ==================== -->
    <!-- Base: alto 40, radio 9; muestra c:Ui.Icono a la izquierda del texto si se define -->
    <Style x:Key="Boton" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Verde}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:Icono x:Name="ico" Geometria="{Binding (c:Ui.Icono), RelativeSource={RelativeSource TemplatedParent}}"
                                     Tamano="15" Grosor="2.2" Foreground="{TemplateBinding Foreground}" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icono" Value="{x:Null}">
                            <Setter TargetName="ico" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonVerde" TargetType="Button" BasedOn="{StaticResource Boton}"/>
    <Style x:Key="BotonAzul" TargetType="Button" BasedOn="{StaticResource Boton}">
        <Setter Property="Background" Value="{StaticResource Azul}"/>
    </Style>
    <Style x:Key="BotonMorado" TargetType="Button" BasedOn="{StaticResource Boton}">
        <Setter Property="Background" Value="{StaticResource Morado}"/>
    </Style>
    <Style x:Key="BotonOscuro" TargetType="Button" BasedOn="{StaticResource Boton}">
        <Setter Property="Background" Value="{StaticResource Oscuro}"/>
    </Style>
    <!-- Secundario: fondo blanco con borde -->
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource Boton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeInput}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RojoBorde}"/>
    </Style>

    <!-- Botón solo de ícono 32×32 (siempre con AutomationProperties.Name) -->
    <Style x:Key="BotonIcono" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Azul}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <c:Icono Geometria="{Binding (c:Ui.Icono), RelativeSource={RelativeSource TemplatedParent}}"
                                 Tamano="15" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Texto}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonIconoPeligro" TargetType="Button" BasedOn="{StaticResource BotonIcono}">
        <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RojoBorde}"/>
    </Style>

    <!-- Enlace de texto ("Ver cuentas") -->
    <Style x:Key="BotonEnlace" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Azul}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nombres anteriores -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BotonAzul}">
        <Setter Property="c:Ui.Icono" Value="{StaticResource IcoPlus}"/>
    </Style>
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cápsula del selector de mes: botón de flecha -->
    <Style x:Key="BotonFlecha" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <c:Icono Geometria="{Binding (c:Ui.Icono), RelativeSource={RelativeSource TemplatedParent}}"
                                 Tamano="16" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- "Mes actual": vuelve al mes en curso; mismo alto y borde que la cápsula del mes -->
    <Style x:Key="BotonMesActual" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="Foreground" Value="{StaticResource Azul}"/>
        <Setter Property="c:Ui.Icono" Value="{StaticResource IcoCalendario}"/>
        <Setter Property="Content" Value="Mes actual"/>
        <Setter Property="ToolTip" Value="Volver al mes en curso"/>
        <Setter Property="AutomationProperties.Name" Value="Volver al mes actual"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="CapsulaMes" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ==================== TARJETAS ==================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="TarjetaOscura" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Oscuro}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Oscuro}"/>
    </Style>
    <!-- Recuadro gris dentro de una tarjeta (indicadores del detalle) -->
    <Style x:Key="Recuadro" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GrisSuave}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="13,10"/>
    </Style>
    <!-- Tarjeta punteada (estado vacío / sugerencia) -->
    <Style x:Key="TarjetaPunteada" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#C8CFDA" StrokeThickness="1.2" StrokeDashArray="4 3"/>
                        <ContentPresenter Margin="20"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Insignia / chip de estado o categoría -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="TextoChip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ==================== BARRA DE PROGRESO ==================== -->
    <!-- Color en Foreground, fondo de la pista en Background; Value de 0 a 1 -->
    <Style x:Key="Barra" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Morado}"/>
        <Setter Property="Background" Value="#EEF1F5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== PESTAÑAS CON SUBRAYADO ==================== -->
    <Style x:Key="Pestana" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="14,10,14,12" HorizontalAlignment="Center"/>
                        <Border x:Name="linea" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Azul}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="linea" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Azul}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CASILLA ==================== -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="box" Width="19" Height="19" CornerRadius="5" Background="White"
                            BorderBrush="#9AA4B2" BorderThickness="1.5">
                        <c:Icono x:Name="check" Geometria="{StaticResource IcoCheck}" Tamano="13" Grosor="3"
                                 Foreground="White" HorizontalAlignment="Center" Visibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Verde}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Verde}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Verde}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TABLAS ==================== -->
    <Style x:Key="EncabezadoTabla" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LineaTabla" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
</ResourceDictionary>
