<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MisFinanzas.Controles">

    <!-- Convertidores de presentación -->
    <c:AnilloConverter x:Key="Anillo"/>
    <c:EstrellaConverter x:Key="Estrella"/>
    <BooleanToVisibilityConverter x:Key="BoolAVisible"/>

    <!-- ==================== TIPOGRAFÍA ==================== -->
    <FontFamily x:Key="FuenteApp">pack://application:,,,/MisFinanzas;component/Recursos/Fuentes/#Plus Jakarta Sans, Segoe UI</FontFamily>

    <!-- ==================== COLORES (tokens) ==================== -->
