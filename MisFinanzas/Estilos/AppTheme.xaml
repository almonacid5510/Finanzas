    <SolidColorBrush x:Key="GrisPista" Color="#8A94A3"/>
    <SolidColorBrush x:Key="Texto" Color="#0F1B2D"/>
    <SolidColorBrush x:Key="Texto2" Color="#5B6676"/>

    <SolidColorBrush x:Key="Oscuro" Color="#0F1B2D"/>
    <SolidColorBrush x:Key="OscuroActivo" Color="#22344F"/>
    <SolidColorBrush x:Key="TextoMenu" Color="#C9D2DE"/>

    <SolidColorBrush x:Key="Verde" Color="#0B7A5C"/>
    <SolidColorBrush x:Key="VerdeTexto" Color="#075E46"/>
    <SolidColorBrush x:Key="VerdeSuave" Color="#E7F5EF"/>
    <SolidColorBrush x:Key="Rojo" Color="#B42318"/>
    <SolidColorBrush x:Key="RojoSuave" Color="#FEF3F2"/>
    <SolidColorBrush x:Key="RojoBorde" Color="#FECDCA"/>
    <SolidColorBrush x:Key="Azul" Color="#1D5BD8"/>
    <SolidColorBrush x:Key="AzulSuave" Color="#EAF0FD"/>
    <SolidColorBrush x:Key="Morado" Color="#6941C6"/>
    <SolidColorBrush x:Key="MoradoSuave" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="MoradoTexto" Color="#5B34B5"/>
    <SolidColorBrush x:Key="MoradoBorde" Color="#D9CEF5"/>
    <SolidColorBrush x:Key="Naranja" Color="#E08A1E"/>
    <SolidColorBrush x:Key="NaranjaTexto" Color="#93370D"/>
    <SolidColorBrush x:Key="NaranjaSuave" Color="#FEF6E7"/>

    <!-- Nombres anteriores (pantallas que aún los usan) -->
    <SolidColorBrush x:Key="BrushFondo" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="BrushTexto" Color="#0F1B2D"/>
    <SolidColorBrush x:Key="BrushTextoSuave" Color="#5B6676"/>
    <SolidColorBrush x:Key="BrushTextoTenue" Color="#8A94A3"/>
    <SolidColorBrush x:Key="BrushBorde" Color="#D5DBE4"/>
    <SolidColorBrush x:Key="BrushBordeSuave" Color="#E3E7EE"/>
    <SolidColorBrush x:Key="BrushInputFondo" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAcento" Color="#1D5BD8"/>
    <SolidColorBrush x:Key="BrushAcentoHover" Color="#174BB5"/>
    <SolidColorBrush x:Key="BrushAcentoPress" Color="#123C93"/>
    <SolidColorBrush x:Key="BrushOscuro" Color="#0F1B2D"/>

