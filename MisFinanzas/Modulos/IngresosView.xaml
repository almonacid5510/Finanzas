<UserControl x:Class="MisFinanzas.Modulos.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:c="clr-namespace:MisFinanzas.Controles">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Style="{StaticResource CapsulaMes}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoIzquierda}" IsEnabled="False"
                            AutomationProperties.Name="Mes anterior" ToolTipService.ShowOnDisabled="True" ToolTip="Muestra el mes en curso"/>
                    <TextBlock x:Name="lblPeriodo" Width="150" TextAlignment="Center" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoDerecha}" IsEnabled="False"
                            AutomationProperties.Name="Mes siguiente" ToolTipService.ShowOnDisabled="True" ToolTip="Muestra el mes en curso"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Ingresos y ahorro" Style="{StaticResource TituloPagina}"/>
                <TextBlock Text="Tu salario, ingresos extra y metas de ahorro" Style="{StaticResource SubtituloPagina}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== TRES TARJETAS ===== -->
        <c:GrillaAdaptable Grid.Row="1" Grid.ColumnSpan="3" Columnas="3" AnchoMinimo="250" Margin="0,0,0,14">
            <!-- Salario (editable en el lugar) -->
            <Border Style="{StaticResource TarjetaOscura}" Padding="20,18">
                <Grid>
                    <StackPanel x:Name="pnlLecturaSalario">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="BtnActivarEdicion_Click" Style="{StaticResource BotonIcono}"
                                    c:Ui.Icono="{StaticResource IcoEditar}" Background="Transparent" BorderBrush="#3A4A61"
                                    Foreground="{StaticResource TextoMenu}" AutomationProperties.Name="Editar salario" ToolTip="Editar salario"/>
                            <TextBlock Text="SALARIO MENSUAL" Style="{StaticResource EtiquetaSeccion}" Foreground="{StaticResource TextoMenu}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="lblIngresoTotal" FontSize="30" FontWeight="ExtraBold" Foreground="White" Margin="0,6,0,2"/>
                        <TextBlock Text="Base de tu presupuesto mensual" Style="{StaticResource TextoSecundario}" Foreground="{StaticResource TextoMenu}"/>
                    </StackPanel>
                    <StackPanel x:Name="pnlEdicionSalario" Visibility="Collapsed">
                        <Label Content="Nuevo salario mensual" Target="{Binding ElementName=txtEditarSalario}" Style="{StaticResource Etiqueta}" Foreground="{StaticResource TextoMenu}"/>
                        <TextBox x:Name="txtEditarSalario" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Guardar" Click="BtnConfirmarSalario_Click" Style="{StaticResource BotonVerde}" Height="34" c:Ui.Icono="{StaticResource IcoCheck}"/>
                            <Button Content="Cancelar" Click="BtnCancelarEdicion_Click" Style="{StaticResource BotonSecundario}" Height="34" Margin="8,0,0,0"
                                    Background="Transparent" Foreground="White" BorderBrush="#3A4A61"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBlock x:Name="lblTituloOtrosIngresosMes" Text="OTROS INGRESOS" Style="{StaticResource EtiquetaSeccion}"/>
                    <TextBlock x:Name="lblOtrosIngresosMes" Text="$ 0" FontSize="30" FontWeight="ExtraBold" Margin="0,6,0,2"/>
                    <TextBlock x:Name="lblTotalIngresosMes" Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="AHORRO TOTAL ACUMULADO" Style="{StaticResource EtiquetaSeccion}"/>
                    <TextBlock x:Name="lblAhorroAcumulado" Text="$ 0" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource VerdeTexto}" Margin="0,6,0,2"/>
                    <TextBlock x:Name="lblMetasResumen" Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
        </c:GrillaAdaptable>

        <!-- ===== OTROS INGRESOS ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="Bonos, ventas, arriendos…" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTituloOtrosIngresos" Text="Otros ingresos" Style="{StaticResource TituloTarjeta}"/>
                </DockPanel>

                <!-- Formulario en una fila -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Descripción" Target="{Binding ElementName=txtDescIngreso}" Style="{StaticResource Etiqueta}"/>
                    <TextBox Grid.Row="1" x:Name="txtDescIngreso" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. Venta de bicicleta"/>
                    <Label Grid.Column="2" Content="Etiqueta" Target="{Binding ElementName=cbEtiquetaIngreso}" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbEtiquetaIngreso" IsEditable="True" Style="{StaticResource ModernCombo}"
                              MaxDropDownHeight="260" ToolTip="Elige una etiqueta o escribe una nueva"/>
                    <Label Grid.Column="4" Content="Valor" Target="{Binding ElementName=txtValorIngreso}" Style="{StaticResource Etiqueta}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="txtValorIngreso" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"/>
                    <Label Grid.Column="6" Content="Frecuencia" Target="{Binding ElementName=cbFrecuenciaIngreso}" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Grid.Row="1" Grid.Column="6" x:Name="cbFrecuenciaIngreso" Style="{StaticResource ModernCombo}"/>
                    <Button Grid.Row="1" Grid.Column="8" Content="Agregar" Click="BtnAgregarIngreso_Click" Style="{StaticResource BotonVerde}"
                            c:Ui.Icono="{StaticResource IcoPlus}"/>
                </Grid>

                <!-- Ingresos de este mes -->
                <ItemsControl x:Name="icIngresosExtra" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LineaTabla}" Padding="4,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Descripcion}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{Binding FondoCategoria}">
                                        <TextBlock Text="{Binding Categoria}" Style="{StaticResource TextoChip}" Foreground="{Binding ColorCategoria}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Frecuencia}" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Venta, StringFormat='{}{0:C0}'}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{StaticResource VerdeTexto}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Click="BtnEliminarIngreso_Click" Style="{StaticResource BotonIconoPeligro}" HorizontalAlignment="Right"
                                            c:Ui.Icono="{StaticResource IcoEliminar}" AutomationProperties.Name="Eliminar ingreso" ToolTip="Eliminar desde este mes"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl x:Name="lblSinIngresosExtra" Style="{StaticResource TarjetaPunteada}" Height="140" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Icono Geometria="{StaticResource IcoMasCirculo}" Tamano="17" Foreground="{StaticResource Texto2}" Margin="0,0,9,0"/>
                        <TextBlock Text="Aún no registras otros ingresos este mes." FontSize="13.5" Foreground="{StaticResource Texto2}"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Border>

        <!-- ===== NUEVA META (columna derecha, alto doble) ===== -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Agregar meta" Click="BtnNuevaMeta_Click" Style="{StaticResource BotonOscuro}"
                        c:Ui.Icono="{StaticResource IcoPlus}" Margin="0,16,0,0"/>
                <StackPanel>
                    <TextBlock Text="Nueva meta de ahorro" Style="{StaticResource TituloTarjeta}"/>
                    <TextBlock Text="Define cuánto quieres reunir y en cuántos meses; calculamos tu cuota." Style="{StaticResource TextoSecundario}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <Label Content="Nombre de la meta" Target="{Binding ElementName=txtNombreMeta}" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtNombreMeta" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. Viaje, fondo de emergencia" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Valor objetivo" Target="{Binding ElementName=txtValorMeta}" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtValorMeta" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"
                                     c:Ui.Pista="$ 0" TextChanged="CamposMeta_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Meses" Target="{Binding ElementName=txtMesesMeta}" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtMesesMeta" Style="{StaticResource ModernInputNumeric}" c:Ui.Pista="12" MaxLength="3"
                                     TextChanged="CamposMeta_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Recuadro}" Margin="0,14,0,0" Padding="13,12">
                        <DockPanel>
                            <TextBlock x:Name="lblCuotaEstimada" DockPanel.Dock="Right" Text="$ —" FontSize="14" FontWeight="ExtraBold"/>
                            <TextBlock Text="Cuota mensual estimada" FontSize="13" Foreground="{StaticResource Texto2}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MIS METAS ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Mis metas" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,12"/>
                <TextBlock x:Name="lblSinMetas" Text="Aún no tienes metas. Crea la primera con el formulario de la derecha."
                           Style="{StaticResource TextoSecundario}" Visibility="Collapsed"/>
                <ItemsControl x:Name="icMetas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Anillo de progreso -->
                                    <Grid Width="70" Height="70" Margin="0,0,18,0">
                                        <Ellipse Stroke="{StaticResource VerdeSuave}" StrokeThickness="8"/>
                                        <Ellipse Stroke="{StaticResource Verde}" StrokeThickness="8" StrokeDashCap="Flat" RenderTransformOrigin="0.5,0.5"
                                                 StrokeDashArray="{Binding Progreso, Converter={StaticResource Anillo}, ConverterParameter='%70,8'}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Progreso, StringFormat='{}{0:0} %'}" FontSize="14" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NombreMostrar}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="13.5" Margin="0,2,0,0">
                                            <Run Text="{Binding MontoActual, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource VerdeTexto}"/>
                                            <Run Text="de" Foreground="{StaticResource Texto2}"/>
                                            <Run Text="{Binding MontoObjetivo, StringFormat='{}{0:C0}', Mode=OneWay}" Foreground="{StaticResource Texto2}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,2,0,0">
                                            <Run Text="Te faltan"/>
                                            <Run Text="{Binding Faltante, StringFormat='{}{0:C0}', Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Abono: el campo y el botón comparten la misma grilla (BtnAbonarMeta_Click busca el campo ahí) -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtAbonoLocal" Tag="{Binding}" Style="{StaticResource ModernInputNumeric}"
                                                 local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"
                                                 AutomationProperties.Name="Valor del abono"/>
                                        <Button Grid.Column="1" Content="Abonar" Click="BtnAbonarMeta_Click" CommandParameter="{Binding}"
                                                Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Click="BtnEliminarMeta_Click" CommandParameter="{Binding}" Style="{StaticResource BotonIconoPeligro}"
                                                c:Ui.Icono="{StaticResource IcoEliminar}" Width="40" Height="40" Margin="8,0,0,0"
                                                AutomationProperties.Name="Eliminar meta" ToolTip="Eliminar meta"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#660F1B2D" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Width="48" Height="48" Background="{StaticResource RojoSuave}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <c:Icono Geometria="{StaticResource IcoEliminar}" Tamano="20" Foreground="{StaticResource Rojo}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar meta" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="txtConfirmMsg" FontSize="13.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="ConfirmCancelar_Click" Style="{StaticResource BotonSecundario}" IsCancel="True"/>
                    <Button Content="Eliminar" Click="ConfirmEliminar_Click" Style="{StaticResource Boton}" Background="{StaticResource Rojo}"
                            c:Ui.Icono="{StaticResource IcoEliminar}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
