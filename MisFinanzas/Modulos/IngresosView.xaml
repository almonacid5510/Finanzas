<UserControl x:Class="MisFinanzas.Modulos.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:controles="clr-namespace:MisFinanzas.Controles"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F0F2F5">
  <Grid>
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" controles:ScrollPagina.Activo="True">
    <Grid Margin="18,12,18,18">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,14">
			<TextBlock Text="Mi Plan de Ahorro e Ingresos" Style="{StaticResource PageTitle}"/>
			<Rectangle Height="4" Width="60" Fill="#27AE60" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
		</StackPanel>

		<UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
			<Border Background="#2D3748" CornerRadius="12" Padding="20" Margin="0,0,10,0">
				<StackPanel>
					<TextBlock Text="SALARIO MENSUAL" FontSize="11" FontWeight="Bold" Foreground="#A0AEC0"/>
					<Grid Margin="0,5,0,0">
						<StackPanel x:Name="pnlLecturaSalario" Orientation="Horizontal">
							<TextBlock x:Name="lblIngresoTotal" Text="$ 0" FontSize="28" FontWeight="Black" Foreground="White"/>
							<Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnActivarEdicion_Click" Margin="10,0,0,0">
								<TextBlock Text="✏️" FontSize="14" Foreground="#A0AEC0"/>
							</Button>
						</StackPanel>
						<StackPanel x:Name="pnlEdicionSalario" Orientation="Horizontal" Visibility="Collapsed">
							<TextBox x:Name="txtEditarSalario" FontSize="22" Width="180" Background="#3D495D" Foreground="White" BorderThickness="1" BorderBrush="#27AE60" VerticalContentAlignment="Center" local:NumeroHelper.EsMoneda="True"/>
							<Button Content="✔️" Click="BtnConfirmarSalario_Click" Background="Transparent" Foreground="#27AE60" BorderThickness="0" FontSize="18" Margin="5,0,0,0" Cursor="Hand"/>
							<Button Content="❌" Click="BtnCancelarEdicion_Click" Background="Transparent" Foreground="#E53E3E" BorderThickness="0" FontSize="18" Margin="5,0,0,0" Cursor="Hand"/>
						</StackPanel>
					</Grid>
					<TextBlock x:Name="lblTotalIngresosMes" FontSize="11" Foreground="#A0AEC0" Margin="0,4,0,0"/>
				</StackPanel>
			</Border>

			<Border Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
				<Border.Effect>
					<DropShadowEffect BlurRadius="15" Opacity="0.05" ShadowDepth="2"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="AHORRO TOTAL ACUMULADO" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
					<TextBlock x:Name="lblAhorroAcumulado" Text="$ 0" FontSize="28" FontWeight="Black" Foreground="#27AE60"/>
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- ===== OTROS INGRESOS (freelance, arriendo, bonos...) con etiqueta propia ===== -->
		<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
					<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2F855A" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock x:Name="lblTituloOtrosIngresos" Text="Otros ingresos" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
				</StackPanel>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="150"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="110"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPCIÓN" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtDescIngreso" Style="{StaticResource ModernInput}"/>

					<TextBlock Grid.Row="0" Grid.Column="2" Text="ETIQUETA" Style="{StaticResource FieldLabel}"/>
					<ComboBox  Grid.Row="1" Grid.Column="2" x:Name="cbEtiquetaIngreso" IsEditable="True" Style="{StaticResource ModernCombo}"
					           MaxDropDownHeight="260" ToolTip="Elige una etiqueta o escribe una nueva"/>

					<TextBlock Grid.Row="0" Grid.Column="4" Text="VALOR ($)" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtValorIngreso" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

					<TextBlock Grid.Row="0" Grid.Column="6" Text="FRECUENCIA" Style="{StaticResource FieldLabel}"/>
					<ComboBox  Grid.Row="1" Grid.Column="6" x:Name="cbFrecuenciaIngreso" Style="{StaticResource ModernCombo}"/>

					<Button Grid.Row="1" Grid.Column="8" Content="AGREGAR" Click="BtnAgregarIngreso_Click"
					        Style="{StaticResource PrimaryButton}" Background="#2F855A" MinWidth="120"/>
				</Grid>

				<!-- Ingresos extra de este mes -->
				<ItemsControl x:Name="icIngresosExtra" Margin="0,12,0,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="#F8FAFC" BorderBrush="#EDF2F7" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,4,8,0">
								<StackPanel Orientation="Horizontal">
									<Border Background="{Binding FondoCategoria}" CornerRadius="6" Padding="7,1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Categoria}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ColorCategoria}"/>
									</Border>
									<TextBlock Text="{Binding Descripcion}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" Margin="8,0" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding Venta, StringFormat='{}{0:C0}'}" FontSize="12" FontWeight="Bold" Foreground="#2F855A" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding Frecuencia}" FontSize="10" Foreground="#A0AEC0" Margin="8,0,0,0" VerticalAlignment="Center"/>
									<Button Content="✕" Click="BtnEliminarIngreso_Click" ToolTip="Eliminar desde este mes"
									        Background="Transparent" BorderThickness="0" Foreground="#E53E3E" Cursor="Hand" Margin="6,0,0,0" Padding="4,0"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock x:Name="lblSinIngresosExtra" Text="Aún no registras otros ingresos este mes." FontSize="12" Foreground="#A0AEC0" Margin="0,10,0,0"/>
			</StackPanel>
		</Border>

		<Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,14">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
					<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#27AE60" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock Text="Configurar nueva meta" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
				</StackPanel>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="160"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="90"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="NOMBRE DE LA META" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtNombreMeta" Style="{StaticResource ModernInput}"/>

					<TextBlock Grid.Row="0" Grid.Column="2" Text="VALOR OBJETIVO ($)" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="2" x:Name="txtValorMeta" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

					<TextBlock Grid.Row="0" Grid.Column="4" Text="MESES" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtMesesMeta" Style="{StaticResource ModernInput}"/>

					<Button Grid.Row="1" Grid.Column="6" Content="AGREGAR META" Click="BtnNuevaMeta_Click"
                            Style="{StaticResource PrimaryButton}" Background="#27AE60" MinWidth="150"/>
				</Grid>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="icMetas">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="2"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="White" CornerRadius="12" Padding="15" Margin="5" Height="180">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="1"/>
							</Border.Effect>
							<Grid>
								<Button Content="✕" Click="BtnEliminarMeta_Click" CommandParameter="{Binding}"
										HorizontalAlignment="Right" VerticalAlignment="Top"
										Background="Transparent" BorderThickness="0" Foreground="#E53E3E" Margin="0,-5,-5,0"
										Panel.ZIndex="10" Cursor="Hand"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="90"/>
									</Grid.ColumnDefinitions>

									<!-- Columna Izquierda: Detalles de la Meta y Acciones -->
									<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0">
										<!-- Nombre de la Meta -->
										<TextBlock Text="{Binding Nombre}" FontWeight="Bold" Foreground="#2D3748" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

										<!-- Ahorrado / Objetivo -->
										<StackPanel Margin="0,0,0,6">
											<TextBlock Text="Ahorrado / Objetivo:" FontSize="10" Foreground="#718096"/>
											<StackPanel Orientation="Horizontal">
												<TextBlock Text="{Binding MontoActual, StringFormat='{}{0:C0}'}" FontWeight="Bold" Foreground="#2ECC71" FontSize="13"/>
												<TextBlock Text=" de " FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
												<TextBlock Text="{Binding MontoObjetivo, StringFormat='{}{0:C0}'}" FontWeight="Bold" Foreground="#4A5568" FontSize="13"/>
											</StackPanel>
										</StackPanel>

										<!-- Cuota Mensual -->
										<StackPanel Margin="0,0,0,10">
											<TextBlock Text="Cuota mensual estimada:" FontSize="10" Foreground="#718096"/>
											<TextBlock Text="{Binding CuotaMensual, StringFormat='{}{0:C0}'}" FontWeight="Bold" Foreground="#3182CE" FontSize="13"/>
										</StackPanel>

										<!-- Input y Botón de Abono -->
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/><!-- TextBox ocupa el espacio disponible -->
												<ColumnDefinition Width="Auto"/><!-- Botón tamaño fijo -->
											</Grid.ColumnDefinitions>
											<TextBox x:Name="txtAbonoLocal" Tag="{Binding}"
													 Text="" Height="34"
													 HorizontalAlignment="Stretch"
													 local:NumeroHelper.EsMoneda="True"
													 Style="{StaticResource ModernInput}" Margin="0,0,6,0"/>
											<Button Grid.Column="1" Click="BtnAbonarMeta_Click" CommandParameter="{Binding}"
													Height="34" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="11">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border x:Name="b" Background="#3182CE" CornerRadius="8" Padding="12,0">
															<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
																<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
																<TextBlock Text="ABONAR" VerticalAlignment="Center"/>
															</StackPanel>
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="b" Property="Background" Value="#2B6CB0"/>
															</Trigger>
															<Trigger Property="IsPressed" Value="True">
																<Setter TargetName="b" Property="Background" Value="#2C5282"/>
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Button.Template>
											</Button>
										</Grid>
									</StackPanel>

									<!-- Columna Derecha: Indicador Circular Premium -->
									<Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0">
										<!-- Círculo de Fondo -->
										<Ellipse Width="70" Height="70" Stroke="#EDF2F7" StrokeThickness="6"/>
										
										<!-- Círculo de Progreso Rellenable -->
										<Ellipse Width="70" Height="70" Stroke="#2ECC71" StrokeThickness="6"
												 StrokeDashArray="33.5 100"
												 StrokeDashOffset="{Binding ProgresoStrokeOffsetSmall, Mode=OneWay}"
												 RenderTransformOrigin="0.5,0.5">
											<Ellipse.RenderTransform>
												<RotateTransform Angle="-90"/>
											</Ellipse.RenderTransform>
										</Ellipse>
										
										<!-- Texto de Porcentaje en el Centro -->
										<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
											<TextBlock Text="{Binding Progreso, StringFormat={}{0:F0}%}" FontSize="15" FontWeight="Black" Foreground="#2D3748" HorizontalAlignment="Center"/>
											<TextBlock Text="progreso" FontSize="8" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
										</StackPanel>
									</Grid>
								</Grid>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
    </ScrollViewer>

    <!-- ===== TOAST / NOTIFICACIÓN DISCRETA ===== -->
    <controles:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="380" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.3" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" Background="#FFF5F5" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar meta" FontSize="18" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtConfirmMsg" Text="¿Seguro que deseas eliminar esta meta?"
                           FontSize="13" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Click="ConfirmCancelar_Click"
                            Height="42" Cursor="Hand" Foreground="#4A5568" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#EDF2F7" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Eliminar" Click="ConfirmEliminar_Click"
                            Height="42" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E53E3E" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#C53030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>