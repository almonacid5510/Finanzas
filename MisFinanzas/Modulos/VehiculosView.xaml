<UserControl x:Class="MisFinanzas.Modulos.VehiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:MisFinanzas.Controles"
             Background="#F0F2F5">
  <Grid>
	<Grid Margin="25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Mis Vehículos" Style="{StaticResource PageTitle}"/>
			<Rectangle Height="4" Width="60" Fill="#3498DB" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
		</StackPanel>

		<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,25">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
					<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3498DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock Text="Registrar nuevo vehículo" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
				</StackPanel>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1.5*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="ALIAS VEHÍCULO" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtNombreVehiculo" Style="{StaticResource ModernInput}"/>

					<TextBlock Grid.Row="0" Grid.Column="2" Text="TIPO" Style="{StaticResource FieldLabel}"/>
					<ComboBox  Grid.Row="1" Grid.Column="2" x:Name="cbTipoVehiculo" Style="{StaticResource ModernCombo}">
						<ComboBoxItem Content="Moto"/>
						<ComboBoxItem Content="Carro"/>
					</ComboBox>

					<TextBlock Grid.Row="0" Grid.Column="4" Text="PLACA" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtPlaca" Style="{StaticResource ModernInput}"/>

					<Button Grid.Row="1" Grid.Column="6" Content="REGISTRAR" Click="BtnAgregarVehiculo_Click"
                            Style="{StaticResource PrimaryButton}" Background="#3498DB" MinWidth="130"/>
				</Grid>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel>
			<!-- Header row -->
			<Grid Margin="5,0,5,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/><!-- Icon -->
					<ColumnDefinition Width="2*"/><!-- Alias -->
					<ColumnDefinition Width="*"/><!-- Placa/Tipo -->
					<ColumnDefinition Width="Auto"/><!-- Inversión -->
					<ColumnDefinition Width="Auto"/><!-- Acción -->
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="1" Text="Alias" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Left"/>
				<TextBlock Grid.Column="2" Text="Placa" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Center"/>
				<TextBlock Grid.Column="3" Text="Inversión Total" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Right" Margin="0,0,40,0"/>
			</Grid>
			<ItemsControl x:Name="icListaVehiculos">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="White" Margin="0,0,0,15" Padding="20" CornerRadius="12"
                                MouseLeftButtonUp="TarjetaVehiculo_Click" Cursor="Hand">
							<Border.Effect>
								<DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
							</Border.Effect>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/><!-- Icon -->
									<ColumnDefinition Width="2*"/><!-- Alias -->
									<ColumnDefinition Width="*"/><!-- Placa/Tipo -->
									<ColumnDefinition Width="Auto"/><!-- Inversión -->
									<ColumnDefinition Width="Auto"/><!-- Acción -->
								</Grid.ColumnDefinitions>

								<Border Grid.Column="0" Width="50" Height="50" Background="#F0F4F8" CornerRadius="25" Margin="0,0,15,0">
									<TextBlock x:Name="txtIcono" Text="🚗" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>

								<StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
									<TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="Bold" Foreground="#2D3748"/>
								</StackPanel>

								<TextBlock Grid.Column="2" Text="{Binding Placa}" FontSize="13" Foreground="#718096" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

								<StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="15,0">
									<TextBlock Text="INVERSIÓN TOTAL" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Right"/>
									<TextBlock Text="{Binding TotalInvertido, StringFormat='{}{0:C0}'}"
                                               FontSize="22" FontWeight="Black" Foreground="#2980B9" HorizontalAlignment="Right"/>
								</StackPanel>

								<Button Grid.Column="4" Click="BtnEliminarVehiculo_Click"
										Width="30" Height="30" VerticalAlignment="Center" Margin="10,0,0,0"
										Background="#FDEDEC" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand">
									<Button.Resources>
										<Style TargetType="{x:Type Border}">
											<Setter Property="CornerRadius" Value="15"/>
										</Style>
									</Button.Resources>
									<TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Button>
							</Grid>
						</Border>

						<DataTemplate.Triggers>
							<DataTrigger Binding="{Binding Tipo}" Value="Moto">
								<Setter TargetName="txtIcono" Property="Text" Value="🏍️"/>
							</DataTrigger>
						</DataTemplate.Triggers>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>

    <controles:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.3" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" Background="#FFF5F5" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar vehículo" FontSize="18" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock FontSize="13" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22">
                    <Run Text="¿Seguro que deseas eliminar el vehículo "/><Run x:Name="runNombreVehiculo" FontWeight="Bold" Foreground="#2D3748"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Click="ConfirmCancelar_Click"
                            Height="42" Cursor="Hand" Foreground="#4A5568" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#EDF2F7" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Eliminar" Click="ConfirmEliminar_Click"
                            Height="42" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E53E3E" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#C53030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>