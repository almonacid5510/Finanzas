<UserControl x:Class="MisFinanzas.Modulos.VehiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MisFinanzas.Controles">

    <UserControl.Resources>
        <!-- Vehículo de la lista (seleccionado = borde azul) -->
        <Style x:Key="TarjetaVehiculo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource T_F_FFFFFF}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="14" Padding="15,13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T_F_B9C2CF}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Padding" Value="14,12"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Texto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="Mis vehículos" Style="{StaticResource TituloPagina}"/>
            <TextBlock Style="{StaticResource SubtituloPagina}">
                <Run Text="Capital invertido total"/> <Run x:Name="runCapitalTotal" FontWeight="Bold" Foreground="{StaticResource Azul}"/>
            </TextBlock>
        </StackPanel>

        <!-- ===== LISTA + REGISTRO ===== -->
        <DockPanel Grid.Row="1">
            <!-- Registrar vehículo (abajo) -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="lblTituloFormulario" Text="Registrar vehículo" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,8"/>
                    <Label Content="Alias" Target="{Binding ElementName=txtNombreVehiculo}" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtNombreVehiculo" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. Carro familiar" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Tipo" Target="{Binding ElementName=cbTipoVehiculo}" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="cbTipoVehiculo" Style="{StaticResource ModernCombo}" SelectedIndex="0">
                                <ComboBoxItem Content="Carro"/>
                                <ComboBoxItem Content="Moto"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Placa" Target="{Binding ElementName=txtPlaca}" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtPlaca" Style="{StaticResource ModernInput}" c:Ui.Pista="ABC123" CharacterCasing="Upper" MaxLength="7"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnCancelarEdicion" Content="Cancelar" Click="BtnCancelarEdicion_Click" Style="{StaticResource BotonSecundario}"
                                Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="btnGuardarVehiculo" Grid.Column="1" Content="Registrar" Click="BtnAgregarVehiculo_Click" Style="{StaticResource BotonAzul}"
                                c:Ui.Icono="{StaticResource IcoPlus}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel>
                <ItemsControl x:Name="icListaVehiculos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TarjetaVehiculo}" Click="TarjetaVehiculo_Click"
                                    AutomationProperties.Name="{Binding Nombre, StringFormat='Ver vehículo {0}'}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource AzulSuave}" Margin="0,0,12,0">
                                        <!-- Ícono según el tipo: carro por defecto, moto si el tipo es "Moto" -->
                                        <!-- Grosor 1.35 = trazo 1.8 del diseño original en 32×32 -->
                                        <c:Icono Tamano="26" Grosor="1.35" Foreground="{StaticResource Azul}" HorizontalAlignment="Center">
                                            <c:Icono.Style>
                                                <Style TargetType="c:Icono" BasedOn="{StaticResource {x:Type c:Icono}}">
                                                    <Setter Property="Geometria" Value="{StaticResource IcoVehiculos}"/>
                                                    <Setter Property="Relleno" Value="{StaticResource IcoVehiculosRelleno}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Moto">
                                                            <Setter Property="Geometria" Value="{StaticResource IcoMoto}"/>
                                                            <Setter Property="Relleno" Value="{StaticResource IcoMotoRelleno}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </c:Icono.Style>
                                        </c:Icono>
                                    </Border>
                                    <!-- Nombre y placa juntos: la placa distingue dos vehículos con el mismo nombre -->
                                    <!-- El nombre ocupa siempre el mismo ancho: así todas las placas quedan alineadas -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Nombre}"/>
                                        <Border Grid.Column="1" Background="{StaticResource T_F_FFD43B}" BorderBrush="{StaticResource T_F_0F1B2D}" BorderThickness="1.2" CornerRadius="4"
                                                Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Placa}" FontSize="12" FontWeight="ExtraBold" Foreground="{StaticResource T_T_0F1B2D}"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="lblSinVehiculos" Text="Aún no registras vehículos." Style="{StaticResource TextoSecundario}" Margin="4,0" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== DETALLE DEL VEHÍCULO ===== -->
        <Border x:Name="pnlDetalle" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Eliminar" Click="BtnEliminarVehiculo_Click" Style="{StaticResource BotonPeligro}" Height="36"
                            c:Ui.Icono="{StaticResource IcoEliminar}" VerticalAlignment="Top"
                            AutomationProperties.Name="Eliminar vehículo"/>
                    <Button DockPanel.Dock="Right" Content="Editar" Click="BtnEditarVehiculo_Click" Style="{StaticResource BotonSecundario}" Height="36"
                            c:Ui.Icono="{StaticResource IcoEditar}" VerticalAlignment="Top" Margin="0,0,8,0"
                            AutomationProperties.Name="Editar vehículo"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nombre}" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <!-- Placa con estilo de placa colombiana -->
                        <Border Background="{StaticResource T_F_FFD43B}" BorderBrush="{StaticResource T_F_0F1B2D}" BorderThickness="1.5" CornerRadius="5" Padding="9,2" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Placa}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource T_T_0F1B2D}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <ContentControl x:Name="contDetalle" Focusable="False"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="lblSinDetalle" Grid.Row="1" Grid.Column="2" Text="Registra un vehículo para ver su historial de gastos."
                   Style="{StaticResource TextoSecundario}" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== CONFIRMACIÓN DE ELIMINACIÓN (vehículo o registro del detalle) ===== -->
    <Grid x:Name="OverlayConfirm" Background="#660F1B2D" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="{StaticResource T_F_FFFFFF}" CornerRadius="16" Width="400" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Width="48" Height="48" Background="{StaticResource RojoSuave}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <c:Icono Geometria="{StaticResource IcoEliminar}" Tamano="20" Foreground="{StaticResource Rojo}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtTituloConfirm" FontSize="18" FontWeight="Bold"/>
                <TextBlock FontSize="13.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,6,0,20">
                    <Run Text="¿Seguro que deseas eliminar "/><Run x:Name="runNombreConfirm" FontWeight="Bold" Foreground="{StaticResource Texto}"/><Run x:Name="runFinalConfirm"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="ConfirmCancelar_Click" Style="{StaticResource BotonSecundario}" IsCancel="True"/>
                    <Button Content="Eliminar" Click="ConfirmEliminar_Click" Style="{StaticResource Boton}" Background="{StaticResource Rojo}"
                            c:Ui.Icono="{StaticResource IcoEliminar}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
