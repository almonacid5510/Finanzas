<UserControl x:Class="MisFinanzas.Modulos.CreditosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:modulos="clr-namespace:MisFinanzas.Modulos"
             xmlns:controles="clr-namespace:MisFinanzas.Controles"
             xmlns:local="clr-namespace:MisFinanzas"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Background="#F0F2F5">

    <UserControl.Resources>
        <Style x:Key="ViewStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editando}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editando}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolAVisible"/>

        <!-- Visible solo cuando el valor enlazado es True (Tag del elemento) -->
        <Style x:Key="SiPuedePagar" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PuedePagar}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SiPagado" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pagado}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SiSaldado" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Saldado}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SiNoSaldado" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Saldado}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de acción simple (sin icono +) -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#8E44AD"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonSuave" TargetType="Button" BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BotonEnlace" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E53E3E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,2">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Celda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="EncabezadoCelda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

  <Grid>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestión de Créditos" Style="{StaticResource PageTitle}"/>
            <Rectangle Height="4" Width="60" Fill="#8E44AD" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,25">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#8E44AD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar nuevo crédito" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="NOMBRE" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtNombreCredito" Style="{StaticResource ModernInput}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="CUOTA ($)" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" x:Name="txtCuotaCredito" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="MONTO TOTAL" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtTotalCredito" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="YA PAGADO" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="6" x:Name="txtAbonoCredito" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="8" Text="TASA %" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="8" x:Name="txtTasaEA" Style="{StaticResource ModernInputNumeric}"/>

                    <TextBlock Grid.Row="0" Grid.Column="10" Text="MESES" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="10" x:Name="txtPlazo" Style="{StaticResource ModernInputNumeric}"/>

                    <Button Grid.Row="1" Grid.Column="12" Content="AGREGAR" Click="BtnAgregarCredito_Click"
                            Style="{StaticResource PrimaryButton}" Background="#8E44AD" MinWidth="120"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icListaCreditos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,15" Padding="20" CornerRadius="12" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Resalta la tarjeta mientras se edita -->
                                        <DataTrigger Binding="{Binding Editando}" Value="True">
                                            <Setter Property="Background" Value="#F7FBFF"/>
                                            <Setter Property="BorderBrush" Value="#BEE3F8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- ===== RESUMEN: siempre visible; un clic despliega el detalle ===== -->
                                <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Resumen_Click" ToolTip="Ver detalle del crédito">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NombreCustom}" FontSize="17" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#C6F6D5" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SiSaldado}">
                                                <TextBlock Text="SALDADO" FontSize="10" FontWeight="Bold" Foreground="#276749"/>
                                            </Border>
                                        </StackPanel>
                                        <Grid Height="6" Margin="0,8,40,0">
                                            <Border Background="#EDF2F7" CornerRadius="3"/>
                                            <Border Background="#8E44AD" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Progreso}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Foreground="#718096" Margin="0,4,0,0">
                                            <Run Text="{Binding ProgresoTexto, Mode=OneWay}" FontWeight="Bold" Foreground="#8E44AD"/><Run Text=" pagado de "/><Run Text="{Binding Total, StringFormat='{}{0:C0}', Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="SALDO QUE DEBES" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Disponible, StringFormat='{}{0:C0}'}" FontSize="16" FontWeight="Black" Foreground="#C53030" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="CUOTA DEL MES" FontSize="10" FontWeight="Bold" Foreground="#3182CE" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CuotaEsteMes, StringFormat='{}{0:C0}'}" FontSize="16" FontWeight="Black" Foreground="#2B6CB0" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Estado de la cuota de este mes -->
                                    <Grid Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#F0FFF4" CornerRadius="10" Padding="10,4" Style="{StaticResource SiPagado}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2F855A">
                                                <Run Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Pagada este mes"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#FFFAF0" CornerRadius="10" Padding="10,4" Style="{StaticResource SiPuedePagar}">
                                            <TextBlock Text="Pendiente este mes" FontSize="11" FontWeight="SemiBold" Foreground="#C05621"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="5" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#718096"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerDetalle}" Value="True">
                                                        <Setter Property="Text" Value="&#xE70E;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- ===== DETALLE: solo cuando se selecciona el crédito ===== -->
                                <StackPanel Visibility="{Binding VerDetalle, Converter={StaticResource BoolAVisible}}">
                                <Border Height="1" Background="#EDF2F7" Margin="0,16,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Style="{StaticResource EditStyle}">
                                            <TextBlock Text="Nombre: " Foreground="#718096" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NombreCustom, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="220" Style="{StaticResource EditInputInline}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Monto original: " Foreground="#718096" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Total, StringFormat='{}{0:C0}'}" FontWeight="SemiBold" Style="{StaticResource ViewStyle}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Total, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}" Width="130" Style="{StaticResource EditInputInline}"/>
                                            <TextBlock Foreground="#718096" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource ViewStyle}">
                                                <Run Text="Capital pagado "/><Run Text="{Binding CapitalPagado, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="SemiBold" Foreground="#2D3748"/><Run Text="  ·  Intereses pagados "/><Run Text="{Binding InteresesPagados, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="SemiBold" Foreground="#2D3748"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <!-- Un solo botón que alterna Editar (✎) / Guardar (✔) según el estado -->
                                        <Button Click="BtnToggleEdicion_Click" Margin="5,0" ToolTip="Editar">
                                            <Button.Content>
                                                <TextBlock FontSize="15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✎"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Editando}" Value="True">
                                                                    <Setter Property="Text" Value="✔"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
                                                    <Setter Property="Background" Value="#3498DB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editando}" Value="True">
                                                            <Setter Property="Background" Value="#27AE60"/>
                                                            <Setter Property="ToolTip" Value="Guardar cambios"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✕" Click="BtnEliminar_Click" Margin="5,0" ToolTip="Eliminar">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
                                                    <Setter Property="Background" Value="#E74C3C"/>
                                                    <Style.Triggers>
                                                        <!-- Oculta el botón eliminar mientras se edita, para no confundir -->
                                                        <DataTrigger Binding="{Binding Editando}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TASA E.A." FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"/>
                                            <TextBlock Text="{Binding TasaEA, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Style="{StaticResource ViewStyle}"/>
                                            <TextBox Text="{Binding TasaEA, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Style="{StaticResource EditInputInline}"/>
                                            <TextBlock Text="{Binding TasaMensualTexto}" FontSize="10" Foreground="#A0AEC0" Style="{StaticResource ViewStyle}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PLAZO RESTANTE" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"/>
                                            <TextBlock Text="{Binding PlazoMeses, StringFormat='{}{0} meses'}" FontSize="14" FontWeight="Bold" Style="{StaticResource ViewStyle}"/>
                                            <TextBox Text="{Binding PlazoMeses, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Style="{StaticResource EditInputInline}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SALDO QUE DEBES" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"/>
                                            <TextBlock Text="{Binding Disponible, StringFormat='{}{0:C0}'}" FontSize="16" FontWeight="Black" Foreground="#C53030" Style="{StaticResource ViewStyle}"/>
                                            <TextBox Text="{Binding Disponible, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}" Width="130" HorizontalAlignment="Left" Style="{StaticResource EditInputInline}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="CUOTA MENSUAL" FontSize="10" FontWeight="Bold" Foreground="#3182CE" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CuotaMensual, StringFormat='{}{0:C0}'}" FontSize="20" FontWeight="Black" Foreground="#2B6CB0" HorizontalAlignment="Right" Style="{StaticResource ViewStyle}"/>
                                            <TextBox Text="{Binding CuotaMensual, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}" FontSize="14" Width="130" HorizontalAlignment="Right" Style="{StaticResource EditInputInline}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Próxima cuota y fecha estimada de fin -->
                                <StackPanel Margin="2,10,0,0" Style="{StaticResource SiNoSaldado}">
                                    <TextBlock FontSize="12" Foreground="#4A5568">
                                        <Run Text="Próxima cuota: "/><Run Text="{Binding InteresProximo, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="Bold" Foreground="#C05621"/><Run Text=" a intereses y "/><Run Text="{Binding CapitalProximo, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="Bold" Foreground="#2F855A"/><Run Text=" a capital"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding FinEstimado, Mode=OneWay}"/><Run Text=" · intereses por pagar "/><Run Text="{Binding InteresesPorPagar, StringFormat='{}{0:C0}', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Acciones: pagar la cuota del mes y abonar a capital -->
                                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Left" Click="BtnPagarCuota_Click" Style="{StaticResource BotonAccion}" Margin="0,0,10,0"
                                            Visibility="{Binding PuedePagar, Converter={StaticResource BoolAVisible}}">
                                        <TextBlock>
                                            <Run Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"/><Run Text="  PAGAR CUOTA · "/><Run Text="{Binding NombreMesActual, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>

                                    <Border DockPanel.Dock="Left" Background="#F0FFF4" BorderBrush="#C6F6D5" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="36" Margin="0,0,10,0"
                                            Style="{StaticResource SiPagado}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#2F855A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="12" Foreground="#276749" VerticalAlignment="Center">
                                                <Run Text="Cuota de "/><Run Text="{Binding NombreMesActual, Mode=OneWay}"/><Run Text=" pagada: "/><Run Text="{Binding CuotaEsteMes, StringFormat='{}{0:C0}', Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                            <Button Content="Deshacer" Click="BtnDeshacerCuota_Click" Style="{StaticResource BotonEnlace}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Style="{StaticResource SiNoSaldado}">
                                        <TextBox x:Name="txtAbono" Width="140" Height="36" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"
                                                 ToolTip="Pago extra que va completo a capital"/>
                                        <Button Content="ABONAR A CAPITAL" Click="BtnAbonar_Click" Tag="{Binding ElementName=txtAbono}"
                                                Style="{StaticResource BotonSuave}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Detalle: historial de pagos y plan de pagos -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Historial de pagos -->
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Pagos realizados" FontSize="13" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MES" Style="{StaticResource EncabezadoCelda}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="PAGADO" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="2" Text="INTERÉS" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="3" Text="CAPITAL" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="4" Text="SALDO" Style="{StaticResource EncabezadoCelda}"/>
                                            </Grid>
                                            <TextBlock Text="Aún no hay pagos registrados." FontSize="11" Foreground="#A0AEC0" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Historial.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Historial}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.3*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="1.1*"/>
                                                                    <ColumnDefinition Width="28"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding NombreMes}" FontSize="12" Foreground="#2D3748"/>
                                                                    <Border Background="#E9D8FD" CornerRadius="4" Padding="5,0" Margin="6,0,0,0"
                                                                            Visibility="{Binding EsAbono, Converter={StaticResource BoolAVisible}}">
                                                                        <TextBlock Text="abono" FontSize="9" FontWeight="SemiBold" Foreground="#6B46C1"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Monto, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Interes, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" Foreground="#C05621"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Capital, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" Foreground="#2F855A"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding SaldoNuevo, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" FontWeight="Bold"/>
                                                                <Button Grid.Column="5" Content="✕" Click="BtnDeshacerPago_Click" ToolTip="Deshacer este pago"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        Style="{StaticResource BotonEnlace}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <!-- Plan de pagos (tabla de amortización con el saldo y la cuota actuales) -->
                                    <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Plan de pagos pendiente" FontSize="13" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource EncabezadoCelda}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="MES" Style="{StaticResource EncabezadoCelda}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="CUOTA" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="3" Text="INTERÉS" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="4" Text="CAPITAL" Style="{StaticResource EncabezadoCelda}"/>
                                                <TextBlock Grid.Column="5" Text="SALDO" Style="{StaticResource EncabezadoCelda}"/>
                                            </Grid>
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Plan}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28"/>
                                                                    <ColumnDefinition Width="1.3*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="1.1*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Numero}" Style="{StaticResource Celda}" HorizontalAlignment="Left" Foreground="#A0AEC0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding NombreMes}" Style="{StaticResource Celda}" HorizontalAlignment="Left"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Cuota, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Interes, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" Foreground="#C05621"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding Capital, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" Foreground="#2F855A"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding SaldoFinal, StringFormat='{}{0:C0}'}" Style="{StaticResource Celda}" FontWeight="Bold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <controles:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.3" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" Background="#FFF5F5" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar crédito" FontSize="18" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock FontSize="13" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22">
                    <Run Text="¿Seguro que deseas eliminar el crédito "/><Run x:Name="runNombreCredito" FontWeight="Bold" Foreground="#2D3748"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Click="ConfirmCancelar_Click"
                            Height="42" Cursor="Hand" Foreground="#4A5568" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#EDF2F7" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Eliminar" Click="ConfirmEliminar_Click"
                            Height="42" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E53E3E" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#C53030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>