<UserControl x:Class="MisFinanzas.Modulos.NegocioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:m="clr-namespace:MisFinanzas.Modulos"
             xmlns:c="clr-namespace:MisFinanzas.Controles">

  <UserControl.Resources>
    <m:EstiloInversionConverter x:Key="EstiloInversion"/>

    <!-- Tarjeta de cada inversión: el color y el ícono rotan según su posición -->
    <DataTemplate DataType="{x:Type m:Movimiento}">
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="BtnEliminar_Click" Style="{StaticResource BotonIconoPeligro}" c:Ui.Icono="{StaticResource IcoEliminar}"
                            VerticalAlignment="Top" AutomationProperties.Name="Eliminar inversión" ToolTip="Eliminar inversión"/>
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0"
                            Background="{Binding Converter={StaticResource EstiloInversion}, ConverterParameter=fondo}">
                        <c:Icono Tamano="20" HorizontalAlignment="Center"
                                 Geometria="{Binding Converter={StaticResource EstiloInversion}, ConverterParameter=icono}"
                                 Foreground="{Binding Converter={StaticResource EstiloInversion}, ConverterParameter=color}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Descripcion}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Fecha, StringFormat='Desde el {0:dd/MM/yyyy}'}" Style="{StaticResource TextoSecundario}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="Total invertido" Style="{StaticResource TextoSecundario}" FontSize="13" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding Costo, StringFormat='{}{0:C0}'}" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource VerdeTexto}" Margin="0,0,0,12"/>
                <!-- El campo y el botón comparten la grilla: BtnAbonar_Click busca el campo ahí -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0" Margin="0,0,8,0"
                             AutomationProperties.Name="Valor del abono"/>
                    <Button Grid.Column="1" Content="Abonar" Click="BtnAbonar_Click" Style="{StaticResource BotonVerde}"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Última tarjeta: sugerencia para agregar otra inversión -->
    <DataTemplate DataType="{x:Type m:SugerenciaInversion}">
        <ContentControl Style="{StaticResource TarjetaPunteada}" MinHeight="196">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:Icono Geometria="{StaticResource IcoMasCirculo}" Tamano="24" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center"/>
                <TextBlock Text="Diversifica tu portafolio" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                <TextBlock Text="Usa el formulario de arriba para sumar otra inversión" Style="{StaticResource TextoSecundario}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </ContentControl>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <StackPanel Margin="28,22,28,22">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Mis inversiones" Style="{StaticResource TituloPagina}"/>
            <TextBlock Text="Dónde tienes tu dinero trabajando" Style="{StaticResource SubtituloPagina}"/>
        </StackPanel>

        <!-- ===== TOTAL + NUEVA INVERSIÓN ===== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2.05*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource TarjetaOscura}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="TOTAL INVERTIDO" Style="{StaticResource EtiquetaSeccion}" Foreground="{StaticResource TextoMenu}"/>
                    <TextBlock x:Name="lblTotalNegocio" FontSize="32" FontWeight="ExtraBold" Foreground="#6CE9A6" Margin="0,6,0,12"/>
                    <!-- Distribución por inversión -->
                    <Grid x:Name="barraDistribucion" Height="9"/>
                    <ItemsControl x:Name="icDistribucion" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                    <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextoMenu}">
                                        <Run Text="{Binding Nombre, Mode=OneWay}"/> <Run Text="{Binding PorcentajeTexto, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="Registrar nueva inversión" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Nombre de la inversión" Target="{Binding ElementName=txtDescNegocio}" Style="{StaticResource Etiqueta}"/>
                        <TextBox Grid.Row="1" x:Name="txtDescNegocio" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. CDT, fondo, acciones"/>
                        <Label Grid.Column="2" Content="Monto inicial" Target="{Binding ElementName=txtInversionNegocio}" Style="{StaticResource Etiqueta}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtInversionNegocio" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"/>
                        <Button Grid.Row="1" Grid.Column="4" Content="Agregar" Click="BtnAgregar_Click" Style="{StaticResource BotonVerde}" c:Ui.Icono="{StaticResource IcoPlus}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== TARJETAS DE INVERSIÓN ===== -->
        <ItemsControl x:Name="icListaNegocios">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:GrillaAdaptable Columnas="3" AnchoMinimo="280"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#660F1B2D" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Width="48" Height="48" Background="{StaticResource RojoSuave}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <c:Icono Geometria="{StaticResource IcoEliminar}" Tamano="20" Foreground="{StaticResource Rojo}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar inversión" FontSize="18" FontWeight="Bold"/>
                <TextBlock FontSize="13.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,6,0,20">
                    <Run Text="¿Seguro que deseas eliminar "/><Run x:Name="runNombreMov" FontWeight="Bold" Foreground="{StaticResource Texto}"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="ConfirmCancelar_Click" Style="{StaticResource BotonSecundario}" IsCancel="True"/>
                    <Button Content="Eliminar" Click="ConfirmEliminar_Click" Style="{StaticResource Boton}" Background="{StaticResource Rojo}"
                            c:Ui.Icono="{StaticResource IcoEliminar}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
