<UserControl x:Class="MisFinanzas.Modulos.NegocioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:controles="clr-namespace:MisFinanzas.Controles"
             Background="#F0F2F5">
  <Grid>
	<Grid Margin="25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Control de Negocio" Style="{StaticResource PageTitle}"/>
			<Rectangle Height="4" Width="60" Fill="#2ECC71" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
		</StackPanel>

		<Border Grid.Row="1" Background="#2D3748" CornerRadius="12" Padding="20" Margin="0,0,0,25">
			<StackPanel>
				<TextBlock Text="GANANCIA TOTAL ACUMULADA" FontSize="12" FontWeight="Bold" Foreground="#A0AEC0"/>
				<TextBlock x:Name="lblTotalNegocio" Text="$ 0" FontSize="32" FontWeight="Black" Foreground="#2ECC71"/>
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,25">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
					<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2ECC71" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock Text="Registrar nuevo movimiento" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
				</StackPanel>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPCIÓN" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtDescNegocio" Style="{StaticResource ModernInput}"/>

					<TextBlock Grid.Row="0" Grid.Column="2" Text="INVERSIÓN / COSTO" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="2" x:Name="txtInversionNegocio" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

					<TextBlock Grid.Row="0" Grid.Column="4" Text="VENTA / COBRO" Style="{StaticResource FieldLabel}"/>
					<TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtValorNegocio" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

					<Button Grid.Row="1" Grid.Column="6" Content="AGREGAR" Click="BtnAgregar_Click"
                            Style="{StaticResource PrimaryButton}" Background="#2ECC71" MinWidth="120"/>
				</Grid>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
			<!-- Header row -->
			<StackPanel>
			<Grid Margin="5,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*"/><!-- Descripción -->
					<ColumnDefinition Width="*"/><!-- Fecha -->
					<ColumnDefinition Width="Auto"/><!-- Ganancia -->
					<ColumnDefinition Width="Auto"/><!-- Acción -->
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="Descripción" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Left"/>
				<TextBlock Grid.Column="1" Text="Fecha" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Center"/>
				<TextBlock Grid.Column="2" Text="Ganancia" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Right" Margin="0,0,30,0"/>
			</Grid>
			<ItemsControl x:Name="icListaNegocios">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="White" Margin="0,0,0,12" Padding="15" CornerRadius="12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/><!-- Descripción -->
									<ColumnDefinition Width="*"/><!-- Fecha -->
									<ColumnDefinition Width="Auto"/><!-- Ganancia -->
									<ColumnDefinition Width="Auto"/><!-- Acción -->
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="{Binding Descripcion}" FontSize="16" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Left"/>
								</StackPanel>

								<TextBlock Grid.Column="1" Text="{Binding Fecha, StringFormat=d}" FontSize="12" Foreground="#718096" VerticalAlignment="Center" HorizontalAlignment="Center"/>

								<StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
									<TextBlock Text="GANANCIA" FontSize="9" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Right"/>
									<TextBlock Text="{Binding Ganancia, StringFormat='{}{0:C0}'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Right"/>
								</StackPanel>

								<Button Grid.Column="3" Click="BtnEliminar_Click" Width="25" Height="25"
                                        Background="#FDEDEC" Foreground="#E74C3C" BorderThickness="0" VerticalAlignment="Center">
									<Button.Resources>
										<Style TargetType="Border">
											<Setter Property="CornerRadius" Value="13"/>
										</Style>
									</Button.Resources>
									<TextBlock Text="✕" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Button>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>

    <controles:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.3" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" Background="#FFF5F5" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar movimiento" FontSize="18" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock FontSize="13" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22">
                    <Run Text="¿Seguro que deseas eliminar el movimiento "/><Run x:Name="runNombreMov" FontWeight="Bold" Foreground="#2D3748"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Click="ConfirmCancelar_Click"
                            Height="42" Cursor="Hand" Foreground="#4A5568" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#EDF2F7" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Eliminar" Click="ConfirmEliminar_Click"
                            Height="42" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E53E3E" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#C53030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>