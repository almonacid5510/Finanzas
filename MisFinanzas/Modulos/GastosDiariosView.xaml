<!-- Gastos del día a día: registro rápido con una frase y análisis de a dónde se va el dinero -->
<UserControl x:Class="MisFinanzas.Modulos.GastosDiariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:c="clr-namespace:MisFinanzas.Controles">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.6*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*" MinWidth="270"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Style="{StaticResource CapsulaMes}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnMesAnterior" Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoIzquierda}" Click="BtnMesAnterior_Click"
                            AutomationProperties.Name="Mes anterior" ToolTip="Mes anterior"/>
                    <TextBlock x:Name="lblPeriodo" Width="150" TextAlignment="Center" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="btnMesSiguiente" Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoDerecha}" Click="BtnMesSiguiente_Click"
                            AutomationProperties.Name="Mes siguiente" ToolTip="Mes siguiente"/>
                </StackPanel>
            </Border>
            <Button x:Name="btnMesActual" DockPanel.Dock="Right" Click="BtnMesActual_Click" Style="{StaticResource BotonMesActual}" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Gastos del día a día" Style="{StaticResource TituloPagina}"/>
                <TextBlock Text="Comida, transporte, antojos y todo lo que registras desde el celular" Style="{StaticResource SubtituloPagina}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== INDICADORES ===== -->
        <c:GrillaAdaptable Grid.Row="1" Grid.ColumnSpan="3" Columnas="4" AnchoMinimo="200" Margin="0,0,0,14">
            <Border Style="{StaticResource TarjetaOscura}" Padding="18,16">
                <StackPanel>
                    <TextBlock x:Name="lblTituloTotal" Text="GASTADO EN EL MES" Style="{StaticResource EtiquetaSeccion}" Foreground="{StaticResource TextoMenu}"/>
                    <TextBlock x:Name="lblTotal" Style="{StaticResource CifraKpi}" Foreground="White" Margin="0,8,0,2"/>
                    <TextBlock x:Name="lblTotalDetalle" Style="{StaticResource TextoSecundario}" Foreground="{StaticResource TextoMenu}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="PROMEDIO POR DÍA" Style="{StaticResource EtiquetaSeccion}"/>
                    <TextBlock x:Name="lblPromedio" Style="{StaticResource CifraKpi}" Margin="0,8,0,2"/>
                    <TextBlock x:Name="lblPromedioDetalle" Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="CATEGORÍA PRINCIPAL" Style="{StaticResource EtiquetaSeccion}"/>
                    <TextBlock x:Name="lblCategoriaTop" Style="{StaticResource CifraKpi}" FontSize="22" Margin="0,9,0,3" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="lblCategoriaTopDetalle" Style="{StaticResource TextoSecundario}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,16"
                    ToolTip="Gastos pequeños (hasta $ 20.000) que, sumados, se notan">
                <StackPanel>
                    <TextBlock Text="GASTOS HORMIGA" Style="{StaticResource EtiquetaSeccion}"/>
                    <TextBlock x:Name="lblHormiga" Style="{StaticResource CifraKpi}" Foreground="#C4320A" Margin="0,8,0,2"/>
                    <TextBlock x:Name="lblHormigaDetalle" Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </Border>
        </c:GrillaAdaptable>

        <!-- ===== MOVIMIENTOS DEL MES, POR DÍA ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="lblTituloLista" Text="Movimientos" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,6"/>
                <ContentControl x:Name="lblSinGastos" Style="{StaticResource TarjetaPunteada}" Height="140" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Icono Geometria="{StaticResource IcoCelular}" Tamano="17" Foreground="{StaticResource Texto2}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="txtSinGastos" Text="Aún no registras gastos este mes." FontSize="13.5" Foreground="{StaticResource Texto2}"/>
                    </StackPanel>
                </ContentControl>
                <ItemsControl x:Name="icDias">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <!-- Encabezado del día: "Hoy · jueves 15 de octubre" y total -->
                                <DockPanel Margin="2,0,2,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat='{}{0:$&#160;#,##0}'}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Texto2}"/>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource Texto2}">
                                        <Run Text="{Binding Relativo, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Texto}"/><Run Text="{Binding Fecha, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Gastos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,8">
                                                <DockPanel>
                                                    <!-- Ícono de la categoría -->
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{Binding FondoCategoria}" Margin="0,0,12,0">
                                                        <c:Icono Geometria="{Binding Icono}" Tamano="16" Grosor="1.8" Foreground="{Binding ColorCategoria}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Click="BtnEliminar_Click" Style="{StaticResource BotonIconoPeligro}" c:Ui.Icono="{StaticResource IcoEliminar}"
                                                            Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Eliminar gasto" ToolTip="Eliminar gasto"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Monto, StringFormat='{}{0:$&#160;#,##0}'}" FontSize="14" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Descripcion}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding TextoOriginal}"/>
                                                            <!-- Gasto directo de un vehículo: también está en su historial -->
                                                            <Border Background="{StaticResource AzulSuave}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding TieneVehiculo, Converter={StaticResource BoolAVisible}}"
                                                                    ToolTip="También está en el historial del vehículo">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <c:Icono Geometria="{StaticResource IcoVehiculos}" Tamano="12" Grosor="1.6" Foreground="{StaticResource Azul}" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding Vehiculo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Azul}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource Texto2}" Margin="0,2,0,0">
                                                            <Run Text="{Binding Fecha, StringFormat='{}{0:h:mm tt}', Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Categoria, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding ColorCategoria}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== ANÁLISIS (columna derecha) ===== -->
        <StackPanel Grid.Row="2" Grid.Column="2">
            <!-- A dónde se va el dinero: una barra con todas las categorías y su detalle -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="¿A dónde se va tu dinero?" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="lblSinCategorias" Text="Sin gastos este mes." Style="{StaticResource TextoSecundario}" Visibility="Collapsed"/>
                    <Grid x:Name="barraCategorias" Height="8" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="icCategorias">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,9">
                                    <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat='{}{0:$&#160;#,##0}'}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detalle}" FontSize="11.5" Foreground="{StaticResource Texto2}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Lo que más se repite -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Lo que más repites" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,12"/>
                    <ContentControl x:Name="lblSinFrecuentes" Style="{StaticResource TarjetaPunteada}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Margin="12,18">
                            <c:Icono Geometria="{StaticResource IcoRepetir}" Tamano="20" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Cuando un gasto se repita, aquí verás cuánto te cuesta al mes." FontSize="12.5" Foreground="{StaticResource Texto2}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </ContentControl>
                    <ItemsControl x:Name="icFrecuentes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LineaTabla}" Padding="2,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{Binding FondoCategoria}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding VecesTexto}" FontSize="13" FontWeight="ExtraBold" Foreground="{Binding ColorCategoria}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat='{}{0:$&#160;#,##0}'}" FontSize="13.5" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource TextoSecundario}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#660F1B2D" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Width="48" Height="48" Background="{StaticResource RojoSuave}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <c:Icono Geometria="{StaticResource IcoEliminar}" Tamano="20" Foreground="{StaticResource Rojo}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar gasto" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="txtConfirmMsg" FontSize="13.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="ConfirmCancelar_Click" Style="{StaticResource BotonSecundario}" IsCancel="True"/>
                    <Button Content="Eliminar" Click="ConfirmEliminar_Click" Style="{StaticResource Boton}" Background="{StaticResource Rojo}"
                            c:Ui.Icono="{StaticResource IcoEliminar}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
