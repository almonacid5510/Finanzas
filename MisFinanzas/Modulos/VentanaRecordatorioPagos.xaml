<Window x:Class="MisFinanzas.Modulos.VentanaRecordatorioPagos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recordatorio de Pagos Pendientes" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Botón pequeño "marcar pagado" -->
        <Style x:Key="PagarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#48BB78"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38A169"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón cerrar (secundario: transparente con borde) -->
        <Style x:Key="CerrarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#CBD5E0" BorderThickness="1.5" CornerRadius="10" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF2F7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Marco exterior redondeado con sombra -->
    <Border Background="#F0F2F5" CornerRadius="16" Margin="12" MouseLeftButtonDown="Marco_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.25" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Border Width="42" Height="42" Background="#FFF5F5" CornerRadius="21" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="¡Tienes pagos pendientes!" FontSize="22" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Las siguientes cuentas vencen hoy o ya están vencidas:"
                       FontSize="13" Foreground="#718096" Margin="0,0,0,18" HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <!-- Lista: altura automática, con scroll interno solo si hay muchos pagos -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <ItemsControl x:Name="icCuentasPendientes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,5"
                                    BorderBrush="#FED7D7" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                                </Border.Effect>
                                <!-- 3 columnas alineadas verticalmente al centro -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Columna izquierda: título + fecha -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Descripcion}" FontSize="15" FontWeight="Bold" Foreground="#2D3748" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#E53E3E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Fecha, StringFormat='Vence: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#E53E3E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Columna central: monto -->
                                    <TextBlock Grid.Column="1" Text="{Binding Venta, StringFormat='{}{0:C0}'}"
                                               FontSize="16" FontWeight="Black" Foreground="#2B6CB0"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,16,0"/>

                                    <!-- Columna derecha: botón -->
                                    <Button Grid.Column="2" Content="MARCAR PAGADO" Click="BtnPagar_Click" CommandParameter="{Binding}"
                                            Style="{StaticResource PagarButton}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer: botón cerrar secundario alineado a la derecha -->
            <Button Grid.Row="3" Content="CERRAR RECORDATORIO" Click="BtnCerrar_Click"
                    Style="{StaticResource CerrarButton}" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
