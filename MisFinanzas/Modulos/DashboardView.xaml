<UserControl x:Class="MisFinanzas.Modulos.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5"
             Loaded="UserControl_Loaded">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resumen Financiero" FontSize="28" FontWeight="Bold" Foreground="#1A202C" Margin="10,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Top" Margin="0,0,0,20">

            <Border Background="White" CornerRadius="15" Margin="6" Padding="15,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL INGRESOS" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <TextBlock x:Name="lblDashIngresos" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#2F855A" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="15" Margin="6" Padding="15,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="GASTOS Y COMPROMISOS" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <TextBlock x:Name="lblDashGastos" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#E53E3E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="15" Margin="6" Padding="15,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="DISPONIBLE / NETO" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <TextBlock x:Name="lblDashBalance" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#4A5568" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="15" Margin="6" Padding="15,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="INVERSION VEHICULOS" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <TextBlock x:Name="lblDashMoto" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#2B6CB0" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="PROGRESO DE MIS METAS" FontSize="14" FontWeight="Bold" Foreground="#4A5568" Margin="10,15,0,10"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icMetasCirculares">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="15" Padding="20" Margin="10" Width="200" Height="190">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                                    <ProgressBar Value="{Binding Progreso, Mode=OneWay}" Height="12" Maximum="100" Minimum="0" Background="#EDF2F7" Foreground="#319795">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                                                    <Decorator x:Name="PART_Track" HorizontalAlignment="Left">
                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="6"/>
                                                    </Decorator>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding Progreso, StringFormat={}{0:F0}%}" FontSize="16" FontWeight="Black" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding MontoActual, StringFormat='{}{0:C0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#718096" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>