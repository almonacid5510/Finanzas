<UserControl x:Class="MisFinanzas.Modulos.CuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:modulos="clr-namespace:MisFinanzas.Modulos"
             xmlns:local="clr-namespace:MisFinanzas"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F0F2F5">

    <UserControl.Resources>
        <!-- Etiqueta de campo -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <!-- Input de texto moderno: redondeado, alto uniforme y acento azul al enfocar -->
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0B4CC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.25" ShadowDepth="2" Color="#4A90E2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B7DD8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6FC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón del calendario (icono) integrado y limpio -->
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#4A90E2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Width="30" Height="30">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E6F0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox interno del DatePicker sin borde propio -->
        <Style x:Key="DatePickerTextBoxStyle" TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker moderno: redondeado, alto consistente y acento azul al enfocar -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Style="{StaticResource DatePickerTextBoxStyle}"
                                                   BorderThickness="0" Background="Transparent"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>

                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Margin="0,0,3,0" VerticalAlignment="Center"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                       Placement="Bottom" StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A0B4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Control de Gastos y Cuentas" FontSize="26" FontWeight="ExtraBold" Foreground="#2D3748"/>
            <Rectangle Height="4" Width="60" Fill="#4A90E2" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
        </StackPanel>

        <!-- Tarjeta del formulario -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24,20" Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.1" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4A90E2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar nuevo gasto" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPCIÓN DEL GASTO" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtDescCuenta" Style="{StaticResource ModernInput}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="VALOR ($)" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" x:Name="txtValorCuenta" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="FECHA DEL GASTO" Style="{StaticResource FieldLabel}"/>
                    <DatePicker Grid.Row="1" Grid.Column="4" x:Name="dpFechaGasto" Style="{StaticResource ModernDatePicker}"/>

                    <Button Grid.Row="1" Grid.Column="6" Content="AGREGAR GASTO" Click="BtnAgregarCuenta_Click" Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Listas -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="GASTOS DEL MES" FontSize="14" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="Descripción" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="Fecha" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Valor" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                </Grid>

                <ItemsControl x:Name="icCuentas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="0,4" Padding="12,10" HorizontalAlignment="Stretch" BorderBrush="#EDF2F7" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding EstaPagado, UpdateSourceTrigger=PropertyChanged}" 
                                              Click="CheckBox_Click" Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Descripcion}" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="15"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#2D3748"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaPagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Grid.Column="2" Background="#EDF2F7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="12" Foreground="#718096"/>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="{Binding Venta, StringFormat='{}{0:C0}'}" FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                                    <Button Grid.Column="4" Content="✕" Click="BtnEliminar_Click" 
                                            Background="Transparent" Foreground="#E53E3E" BorderThickness="0" 
                                            FontWeight="Bold" FontSize="16" Cursor="Hand" Padding="5,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="5,25,0,10">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2B6CB0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="COMPROMISOS DE CRÉDITOS" FontSize="14" FontWeight="Bold" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Nombre" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Cuota mensual" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                </Grid>

                <ItemsControl x:Name="icCreditosCompromisos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EBF4FF" CornerRadius="10" Margin="0,4" Padding="15" BorderBrush="#BEE3F8" BorderThickness="1" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Pagado, UpdateSourceTrigger=PropertyChanged}" 
                                              Click="CheckBox_Click" Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding NombreCustom}" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="15"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#2C5282"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding CuotaMensual, StringFormat='{}{0:C0}'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Total -->
        <Border Grid.Row="3" CornerRadius="12" Margin="0,20,0,0" Padding="20,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2D3748" Offset="0"/>
                    <GradientStop Color="#3B5266" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL PENDIENTE DEL MES:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
                <TextBlock x:Name="lblTotalPendiente" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#63B3ED"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
