<UserControl x:Class="MisFinanzas.Modulos.CuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:modulos="clr-namespace:MisFinanzas.Modulos"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F0F2F5">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Control de Gastos y Cuentas" FontSize="26" FontWeight="ExtraBold" Foreground="#2D3748"/>
            <Rectangle Height="4" Width="60" Fill="#4A90E2" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="10,0">
                    <TextBlock Text="Descripción del gasto" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="5,0,0,3"/>
                    <TextBox x:Name="txtDescCuenta" Width="220" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Margin="10,0">
                    <TextBlock Text="Valor ($)" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="5,0,0,3"/>
                    <TextBox x:Name="txtValorCuenta" Width="130" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1"/>
                </StackPanel>
                <Button Content="AGREGAR GASTO" Click="BtnAgregarCuenta_Click" Background="#4A90E2" Foreground="White" Width="150" Height="40" Margin="20,15,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="GASTOS DEL MES" FontSize="14" FontWeight="Bold" Foreground="#4A5568" Margin="5,0,0,10"/>
                <ItemsControl x:Name="icCuentas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="0,4" Padding="15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="1"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding EstaPagado, UpdateSourceTrigger=PropertyChanged}" 
                                              Click="CheckBox_Click" 
                                              VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>

                                    <TextBlock Grid.Column="1" Text="{Binding Descripcion}" FontSize="14" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaPagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding Venta, StringFormat='{}{0:C0}'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="#2D3748" 
                                               VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstaPagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="3" Content="✕" Click="BtnEliminar_Click" 
                                            Background="Transparent" Foreground="#E53E3E" BorderThickness="0" 
                                            FontWeight="Bold" FontSize="16" Cursor="Hand" Padding="5,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="COMPROMISOS DE CRÉDITOS" FontSize="14" FontWeight="Bold" Foreground="#2B6CB0" Margin="5,25,0,10"/>
                <ItemsControl x:Name="icCreditosCompromisos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EBF4FF" CornerRadius="10" Margin="0,4" Padding="15" BorderBrush="#BEE3F8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Pagado, UpdateSourceTrigger=PropertyChanged}" 
                                              Click="CheckBox_Click" VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>

                                    <TextBlock Grid.Column="1" Text="{Binding NombreCustom}" FontSize="14" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding CuotaMensual, StringFormat='{}{0:C0}'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pagado}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#2D3748" CornerRadius="10" Margin="0,20,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL PENDIENTE DEL MES:" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>
                <TextBlock x:Name="lblTotalPendiente" Text="$ 0" FontSize="22" FontWeight="Black" Foreground="#63B3ED"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>