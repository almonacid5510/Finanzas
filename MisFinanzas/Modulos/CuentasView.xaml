<UserControl x:Class="MisFinanzas.Modulos.CuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:c="clr-namespace:MisFinanzas.Controles">

  <UserControl.Resources>
    <!-- Atajo morado ("Declaración de renta") -->
    <Style x:Key="ChipAtajo" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource MoradoSuave}" BorderBrush="{StaticResource MoradoBorde}"
                            BorderThickness="1" CornerRadius="14" Padding="11,4">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource MoradoTexto}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource T_F_ECE6FD}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Morado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Insignia de categoría con su color; el borde la separa del fondo de color de la fila -->
    <DataTemplate x:Key="InsigniaCategoria">
        <Border Style="{StaticResource Chip}" Background="{Binding FondoCategoria}" BorderBrush="{Binding BordeCategoria}" BorderThickness="1" Margin="0,0,8,0">
            <TextBlock Text="{Binding Categoria}" Style="{StaticResource TextoChip}" Foreground="{Binding ColorCategoria}"/>
        </Border>
    </DataTemplate>

    <!-- Botón de estado: círculo para pagar; check verde para pago registrado. -->
    <Style x:Key="BotonEstadoPago" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource T_F_FFFFFF}"/>
        <Setter Property="BorderBrush" Value="{StaticResource T_F_98A2B3}"/>
        <Setter Property="Tag" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" CornerRadius="14" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="circulo" Width="11" Height="11" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Margin="0,0,5,0"/>
                            <c:Icono x:Name="checkPago" Geometria="{StaticResource IcoCheck}" Tamano="12" Foreground="{TemplateBinding Foreground}" Margin="0,0,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="textoPago" Text="Marcar pagado" FontSize="11.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Vencida">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource T_F_F04438}"/>
                            <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource T_F_FFFFFF}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource T_F_75E0A7}"/>
                            <Setter TargetName="circulo" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="checkPago" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="textoPago" Property="Text" Value="Pagado"/>
                            <Setter Property="Foreground" Value="{StaticResource T_T_075E46}"/>
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Azul}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="textoPago" Property="Text" Value="{Binding EstadoTexto}"/>
                            <Setter TargetName="circulo" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="borde" Property="Background" Value="{Binding EstadoFondo}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{Binding EstadoColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="borde" Property="Opacity" Value="0.75"/></Trigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions>
                            <Setter TargetName="textoPago" Property="Text" Value="Deshacer"/>
                            <Setter TargetName="checkPago" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource RojoSuave}"/>
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource RojoBorde}"/>
                            <Setter Property="Foreground" Value="{StaticResource Rojo}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filtro de la lista: Todas / Vencidas / Pendientes / Pagadas -->
    <Style x:Key="ChipFiltro" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="GroupName" Value="FiltroCuentas"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="{StaticResource T_F_FFFFFF}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="14" Padding="11,4">
                        <ContentPresenter TextElement.FontSize="12.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T_F_475467}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ConteoFiltro" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <!-- Fila de la lista: tarjeta con el color del estado y una barra a la izquierda -->
    <Style x:Key="FilaCuenta" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Tarjetas de la pestaña de proyección -->
    <Style x:Key="KpiProyeccion" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GrisSuave}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style x:Key="TituloKpi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
    </Style>
    <Style x:Key="ValorKpi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <!-- Columnas de la tabla del mes (encabezado y filas iguales) -->
    <Style x:Key="FilaTabla" TargetType="Grid"/>

    <!-- Tarjeta de la pestaña de historial / proyección -->
    <Style x:Key="SubTitulo" TargetType="TextBlock" BasedOn="{StaticResource TituloTarjeta}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <Grid Margin="28,22,28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="262"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Cuentas del mes" Style="{StaticResource TituloPagina}"/>
            <TextBlock Text="Gastos fijos, compras y cuotas de crédito" Style="{StaticResource SubtituloPagina}"/>
        </StackPanel>
        <Button x:Name="btnMesActual" Click="BtnMesActual_Click" Style="{StaticResource BotonMesActual}" HorizontalAlignment="Right"/>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Border Style="{StaticResource CapsulaMes}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnMesAnterior" Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoIzquierda}" Click="BtnMesAnterior_Click"
                            AutomationProperties.Name="Mes anterior" ToolTip="Mes anterior"/>
                    <TextBlock x:Name="lblMes" Width="150" TextAlignment="Center" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="btnMesSiguiente" Style="{StaticResource BotonFlecha}" c:Ui.Icono="{StaticResource IcoDerecha}" Click="BtnMesSiguiente_Click"
                            AutomationProperties.Name="Mes siguiente" ToolTip="Mes siguiente"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== REGISTRAR GASTO (una fila) ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="btnCancelarEdicion" DockPanel.Dock="Right" Content="Cancelar" Click="BtnCancelarEdicion_Click" Style="{StaticResource BotonSecundario}"
                            VerticalAlignment="Center" Visibility="Collapsed"/>
                    <WrapPanel x:Name="pnlAtajos" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Atajos" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button Content="Declaración de renta" Tag="Declaración de renta|Impuestos|Anual" Click="BtnAtajo_Click" Style="{StaticResource ChipAtajo}"/>
                        <Button Content="Impuesto predial" Tag="Impuesto predial|Impuestos|Anual" Click="BtnAtajo_Click" Style="{StaticResource ChipAtajo}"/>
                        <Button Content="Impuesto vehicular" Tag="Impuesto vehicular|Impuestos|Anual" Click="BtnAtajo_Click" Style="{StaticResource ChipAtajo}"/>
                        <Button Content="Gasto médico" Tag="Consulta médica|Médicos|Única" Click="BtnAtajo_Click" Style="{StaticResource ChipAtajo}"/>
                    </WrapPanel>
                    <TextBlock x:Name="lblTituloFormulario" Text="Registrar gasto" Style="{StaticResource TituloTarjeta}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Descripción" Target="{Binding ElementName=txtDescCuenta}" Style="{StaticResource Etiqueta}"/>
                    <TextBox Grid.Row="1" x:Name="txtDescCuenta" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. Arriendo, internet"/>

                    <Label Grid.Column="2" Content="Categoría" Target="{Binding ElementName=cbCategoria}" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbCategoria" IsEditable="True" Style="{StaticResource ModernCombo}"
                              MaxDropDownHeight="260" ToolTip="Elige una categoría o escribe una nueva"/>

                    <Label Grid.Column="4" Content="Valor" Target="{Binding ElementName=txtValorCuenta}" Style="{StaticResource Etiqueta}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="txtValorCuenta" Style="{StaticResource ModernInputNumeric}"
                             local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"/>

                    <Label Grid.Column="6" Content="Frecuencia" Target="{Binding ElementName=cbFrecuencia}" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Grid.Row="1" Grid.Column="6" x:Name="cbFrecuencia" Style="{StaticResource ModernCombo}"
                              SelectionChanged="CbFrecuencia_SelectionChanged"/>

                    <!-- Mes de los gastos anuales (solo con frecuencia Anual) -->
                    <Label Grid.Column="7" x:Name="lblMesAnual" Content="Mes" Target="{Binding ElementName=cbMesAnual}" Style="{StaticResource Etiqueta}"
                           Margin="8,0,0,0" Visibility="Collapsed"/>
                    <ComboBox Grid.Row="1" Grid.Column="7" x:Name="cbMesAnual" Style="{StaticResource ModernCombo}" Width="112" Margin="8,0,0,0"
                              MaxDropDownHeight="300" Visibility="Collapsed"/>

                    <Label Grid.Column="9" Content="Día" Target="{Binding ElementName=cbDiaPago}" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Grid.Row="1" Grid.Column="9" x:Name="cbDiaPago" Style="{StaticResource ModernCombo}" MaxDropDownHeight="300"/>

                    <Button Grid.Row="1" Grid.Column="11" x:Name="btnGuardarCuenta" Content="Agregar" Click="BtnAgregarCuenta_Click" Style="{StaticResource BotonAzul}"
                            c:Ui.Icono="{StaticResource IcoPlus}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== PESTAÑAS + CONTENIDO ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,6,18,16" VerticalAlignment="Top">
            <StackPanel>
                <Border BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="tabMes" Content="Gastos del mes" GroupName="TabsCuentas" IsChecked="True" Checked="Pestana_Checked" Style="{StaticResource Pestana}"/>
                        <RadioButton x:Name="tabHistorial" Content="Historial" GroupName="TabsCuentas" Checked="Pestana_Checked" Style="{StaticResource Pestana}"/>
                        <RadioButton x:Name="tabProyeccion" Content="Proyección y predicción" GroupName="TabsCuentas" Checked="Pestana_Checked" Style="{StaticResource Pestana}"/>
                    </StackPanel>
                </Border>

                <!-- ================= GASTOS DEL MES ================= -->
                <ScrollViewer x:Name="pnlMes" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <!-- Ocupa el ancho visible; si no cabe (mínimo 680) la tabla se desplaza dentro de su caja -->
                    <StackPanel MinWidth="680" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <TextBlock x:Name="lblTituloGastos" Style="{StaticResource EtiquetaSeccion}" Margin="4,8,0,0" Visibility="Collapsed"/>

                        <!-- Filtros -->
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="Ordenado por fecha de vencimiento" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton IsChecked="True" Tag="Todas" Checked="Filtro_Checked" Style="{StaticResource ChipFiltro}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource T_A_98A2B3}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Todas" FontWeight="SemiBold"/><TextBlock x:Name="lblConteoTodas" Style="{StaticResource ConteoFiltro}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Vencidas" Checked="Filtro_Checked" Style="{StaticResource ChipFiltro}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource T_A_D92D20}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Vencidas" FontWeight="SemiBold"/><TextBlock x:Name="lblConteoVencidas" Style="{StaticResource ConteoFiltro}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Pendientes" Checked="Filtro_Checked" Style="{StaticResource ChipFiltro}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource T_A_F79009}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pendientes" FontWeight="SemiBold"/><TextBlock x:Name="lblConteoPendientes" Style="{StaticResource ConteoFiltro}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Pagadas" Checked="Filtro_Checked" Style="{StaticResource ChipFiltro}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource T_A_12B76A}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pagadas" FontWeight="SemiBold"/><TextBlock x:Name="lblConteoPagadas" Style="{StaticResource ConteoFiltro}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>

                        <!-- Encabezado -->
                        <Grid Style="{StaticResource FilaTabla}" Margin="15,14,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Concepto" Style="{StaticResource EncabezadoTabla}"/>
                            <TextBlock Grid.Column="1" Text="Vence" Style="{StaticResource EncabezadoTabla}"/>
                            <TextBlock Grid.Column="2" Text="Estado" Style="{StaticResource EncabezadoTabla}"/>
                            <TextBlock Grid.Column="3" Text="Valor" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="lblSinGastos" Text="No hay gastos para este mes. Registra el primero con el formulario de arriba."
                                   Style="{StaticResource TextoSecundario}" Margin="6,14" Visibility="Collapsed"/>

                        <ItemsControl x:Name="icCuentas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding FondoFila}" BorderBrush="{Binding Acento}" Style="{StaticResource FilaCuenta}">
                                        <Grid Style="{StaticResource FilaTabla}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="84"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Descripcion}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource InsigniaCategoria}"/>
                                                    <TextBlock Text="{Binding Frecuencia}" FontSize="12.5" Foreground="{StaticResource Texto2}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Vence, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="13.5" Foreground="{Binding ColorFecha}"/>
                                                <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding EstadoColor}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource BotonEstadoPago}" Tag="{Binding Pagada}" Click="EstadoPago_Click"
                                                    ToolTip="{Binding AccionPago}" AutomationProperties.Name="{Binding AccionPago}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Venta, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource T_T_1E3A5F}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Click="BtnEditar_Click" Style="{StaticResource BotonIcono}" c:Ui.Icono="{StaticResource IcoEditar}"
                                                        AutomationProperties.Name="Editar gasto" ToolTip="Editar gasto"/>
                                                <Button Click="BtnEliminar_Click" Style="{StaticResource BotonIconoPeligro}" c:Ui.Icono="{StaticResource IcoEliminar}"
                                                        Margin="6,0,0,0" AutomationProperties.Name="Dejar de cobrar desde este mes" ToolTip="Dejar de cobrar desde este mes"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Cuotas de créditos (solo el mes en curso) -->
                        <StackPanel x:Name="pnlCreditos">
                            <TextBlock Text="COMPROMISOS DE CRÉDITOS" Style="{StaticResource EtiquetaSeccion}" Foreground="{StaticResource MoradoTexto}" Margin="4,10,0,8"/>
                            <ItemsControl x:Name="icCreditosCompromisos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding FondoFila}" BorderBrush="{Binding Acento}" Style="{StaticResource FilaCuenta}">
                                            <Grid Style="{StaticResource FilaTabla}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="84"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Cuota ·"/> <Run Text="{Binding NombreCustom, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Style="{StaticResource Chip}" Background="{StaticResource MoradoSuave}" Margin="0,0,8,0">
                                                            <TextBlock Text="Créditos" Style="{StaticResource TextoChip}" Foreground="{StaticResource MoradoTexto}"/>
                                                        </Border>
                                                        <TextBlock FontSize="12.5" Foreground="{StaticResource Texto2}" VerticalAlignment="Center">
                                                            <Run Text="Saldo"/> <Run Text="{Binding Disponible, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NombreMesActual}" FontSize="13.5" Foreground="{StaticResource Texto2}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding EstadoColor}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource BotonEstadoPago}" Tag="{Binding Pagado}" IsEnabled="{Binding PuedeMarcar}" Click="EstadoPago_Click"
                                                        ToolTip="{Binding AccionPago}" AutomationProperties.Name="{Binding AccionPago}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CuotaEsteMes, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource T_T_1E3A5F}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <!-- Abre el crédito en su pantalla (mismo alto que los botones de editar/eliminar) -->
                                                <Button Grid.Column="4" Content="Ver" Click="BtnVerCredito_Click" Style="{StaticResource BotonSecundario}"
                                                        c:Ui.Icono="{StaticResource IcoCreditos}" Height="32" Padding="11,0" FontSize="12.5"
                                                        Background="{StaticResource MoradoSuave}" Foreground="{StaticResource MoradoTexto}"
                                                        BorderBrush="{StaticResource MoradoBorde}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        AutomationProperties.Name="Ver crédito" ToolTip="Ver el detalle del crédito"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= HISTORIAL ================= -->
                <StackPanel x:Name="pnlHistorial" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Mes a mes" Style="{StaticResource SubTitulo}"/>
                    <TextBlock Text="Gastos = lo pagado realmente + lo pendiente por su valor. No incluye créditos. Haz clic en un mes para ver sus gastos."
                               Style="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True" MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid Margin="10,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HMes" MinWidth="130"/>
                                    <ColumnDefinition Width="*" MinWidth="40"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HIng" MinWidth="104"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HGas" MinWidth="104"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HPag" MinWidth="104"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HPen" MinWidth="104"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HBal" MinWidth="104"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mes" Style="{StaticResource EncabezadoTabla}"/>
                                <TextBlock Grid.Column="2" Margin="16,0,0,0" Text="Ingresos" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="Gastos" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Margin="16,0,0,0" Text="Pagado" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Margin="16,0,0,0" Text="Pendiente" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Margin="16,0,0,0" Text="Balance" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="icHistorial">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnVerMes_Click" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,1"
                                                AutomationProperties.Name="{Binding Nombre, StringFormat='Ver gastos de {0}'}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,9"
                                                            BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AzulSuave}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HMes" MinWidth="130"/>
                                                    <ColumnDefinition Width="*" MinWidth="40"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HIng" MinWidth="104"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HGas" MinWidth="104"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HPag" MinWidth="104"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HPen" MinWidth="104"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HBal" MinWidth="104"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nombre}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource Barra}" Value="{Binding Proporcion, Mode=OneWay}"
                                                             Foreground="{StaticResource T_T_F97066}" Margin="10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Margin="16,0,0,0" Text="{Binding Ingresos, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" Foreground="{StaticResource VerdeTexto}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="{Binding Gastos, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Margin="16,0,0,0" Text="{Binding Pagado, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" Foreground="{StaticResource Texto2}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Margin="16,0,0,0" Text="{Binding Pendiente, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" Foreground="{StaticResource NaranjaTexto}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Margin="16,0,0,0" Text="{Binding Balance, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontWeight="Bold" Foreground="{Binding ColorBalance}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="lblTituloCategorias" Text="Gastos por categoría" Style="{StaticResource SubTitulo}" Margin="0,20,0,10"/>
                    <ItemsControl x:Name="icCategoriasHistorial" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HCat" MinWidth="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Chip}" Background="{Binding ColorFondo}">
                                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource TextoChip}" Foreground="{Binding ColorTexto}"/>
                                    </Border>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Barra}" Value="{Binding Proporcion, Mode=OneWay}"
                                                 Foreground="{Binding ColorBarra}" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Margin="16,0,0,0" Text="{Binding Total, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ================= PROYECCIÓN Y PREDICCIÓN ================= -->
                <StackPanel x:Name="pnlProyeccion" Visibility="Collapsed" Margin="0,12,0,0">
                    <!-- Resumen: tarjetas, aviso y gráfico de los próximos 6 meses -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource KpiProyeccion}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="lblKpiMesTitulo" Style="{StaticResource TituloKpi}"/>
                                        <TextBlock x:Name="lblKpiMes" Style="{StaticResource ValorKpi}"/>
                                        <TextBlock x:Name="lblKpiMesNota" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource KpiProyeccion}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PRÓXIMOS 12 MESES" Style="{StaticResource TituloKpi}"/>
                                        <TextBlock x:Name="lblKpiAnio" Style="{StaticResource ValorKpi}"/>
                                        <TextBlock x:Name="lblKpiAnioNota" FontSize="11.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{StaticResource T_F_FFFAEB}" BorderBrush="{StaticResource T_F_FEDF89}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,10,0">
                                        <Border Width="4" Height="11" CornerRadius="1.5" Background="{StaticResource T_F_F79009}" Margin="0,0,2,0"/>
                                        <Border Width="4" Height="11" CornerRadius="1.5" Background="{StaticResource T_F_F79009}" Opacity="0.6" Margin="0,0,2,0"/>
                                        <Border Width="4" Height="11" CornerRadius="1.5" Background="{StaticResource T_F_F79009}" Opacity="0.3"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Estos valores son aproximados" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource NaranjaTexto}"/>
                                        <TextBlock Text="Salen de lo que escribiste en cada gasto. Se vuelven más exactos a medida que registras tus pagos reales."
                                                   FontSize="11.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                        <WrapPanel>
                                            <TextBlock FontSize="11" Margin="0,0,12,0"><Run Text="0–2 pagos:" FontWeight="Bold" Foreground="{StaticResource T_T_B54708}"/> <Run Text="aproximado" Foreground="{StaticResource Texto2}"/></TextBlock>
                                            <TextBlock FontSize="11" Margin="0,0,12,0"><Run Text="3–5 pagos:" FontWeight="Bold" Foreground="{StaticResource T_T_175CD3}"/> <Run Text="bastante exacto" Foreground="{StaticResource Texto2}"/></TextBlock>
                                            <TextBlock FontSize="11"><Run Text="6 pagos:" FontWeight="Bold" Foreground="{StaticResource T_T_067647}"/> <Run Text="muy exacto" Foreground="{StaticResource Texto2}"/></TextBlock>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource Morado}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Crédito" FontSize="11" Foreground="{StaticResource Texto2}" Margin="0,0,10,0"/>
                                        <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource Verde}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Gastos" FontSize="11" Foreground="{StaticResource Texto2}"/>
                                    </StackPanel>
                                    <TextBlock Text="Próximos 6 meses" FontSize="13" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ItemsControl x:Name="icBarrasProyeccion" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Total}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <Border Height="{Binding AltoGastos}" Background="{StaticResource Verde}" CornerRadius="4,4,0,0"/>
                                                <Border Height="{Binding AltoCreditos}" Background="{StaticResource Morado}"/>
                                                <Border Height="1" Background="{StaticResource Borde}"/>
                                                <TextBlock Text="{Binding Mes}" FontSize="11" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Predicción por gasto -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="680" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Border Style="{StaticResource LineaTabla}" Padding="10,0,10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gasto" Style="{StaticResource EncabezadoTabla}"/>
                                    <TextBlock Grid.Column="2" Text="Próximo pago" Style="{StaticResource EncabezadoTabla}"/>
                                    <TextBlock Grid.Column="3" Text="Previsto / mes" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="12 meses" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="Calculado con" Style="{StaticResource EncabezadoTabla}" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="icPredicciones">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineaTabla}" Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="190"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Margin="0,0,10,0">
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding ColorBarra}" Margin="0,1,10,1"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detalle}" FontSize="11.5" Foreground="{StaticResource Texto2}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource Barra}" Maximum="1" Value="{Binding Proporcion, Mode=OneWay}" Height="4"
                                                             Foreground="{Binding ColorBarra}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ProximoTexto}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Prediccion, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="13.5" FontWeight="Bold"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Proyeccion12, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="13" Foreground="{StaticResource Texto2}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <!-- Créditos: monto fijo. Gastos: un segmento por pago real registrado -->
                                                <Border Grid.Column="5" Style="{StaticResource Chip}" Background="{StaticResource MoradoSuave}" HorizontalAlignment="Left" Margin="16,0,0,0">
                                                    <Border.Visibility>
                                                        <Binding Path="EsCredito"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding>
                                                    </Border.Visibility>
                                                    <TextBlock Text="Cuota fija · exacto" Style="{StaticResource TextoChip}" FontSize="11.5" Foreground="{StaticResource MoradoTexto}"/>
                                                </Border>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsCredito}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ItemsControl ItemsSource="{Binding Segmentos}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><Border Width="4" Height="12" CornerRadius="1.5" Background="{Binding}" Margin="0,0,2,0"/></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding CalculadoCon}" FontSize="11.5" Foreground="{Binding ColorCalculadoCon}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="Mes a mes" Style="{StaticResource SubTitulo}" Margin="0,20,0,0"/>
                    <TextBlock Text="Ingresos (salario + otros ingresos) frente a gastos previstos y cuotas de créditos."
                               Style="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True" MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid Margin="10,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D0" MinWidth="124"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D1" MinWidth="124"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D2" MinWidth="124"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D3" MinWidth="124"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mes" Style="{StaticResource EncabezadoTabla}"/>
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="Ingresos" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Margin="14,0,0,0" Text="Gastos" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Margin="14,0,0,0" Text="Créditos" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Margin="14,0,0,0" Text="Balance" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="icProyeccion">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineaTabla}" Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D0" MinWidth="124"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D1" MinWidth="124"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D2" MinWidth="124"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D3" MinWidth="124"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding Ingresos, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" Foreground="{StaticResource VerdeTexto}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Margin="14,0,0,0" Text="{Binding Gastos, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Margin="14,0,0,0" Text="{Binding Creditos, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" Foreground="{StaticResource MoradoTexto}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Margin="14,0,0,0" Text="{Binding Balance, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontWeight="Bold" Foreground="{Binding ColorBalance}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== COLUMNA DERECHA: resumen del mes ===== -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
            <Border x:Name="barraTotal" Style="{StaticResource TarjetaOscura}" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PENDIENTE DEL MES" Style="{StaticResource EtiquetaSeccion}" Foreground="{StaticResource TextoMenu}"/>
                    <TextBlock x:Name="lblTotalPendiente" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource T_T_A9C5FF}" Margin="0,6,0,10"/>
                    <ProgressBar x:Name="barPagado" Style="{StaticResource Barra}" Background="{StaticResource T_F_2A3A52}" Foreground="{StaticResource T_T_6CE9A6}" Height="7"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="lblTotalMes" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource TextoMenu}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="lblPagadoMes" FontSize="11.5" Foreground="{StaticResource TextoMenu}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Por categoría" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblSinCategoriasMes" Text="Sin gastos este mes." Style="{StaticResource TextoSecundario}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="icCategoriasMes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="3" Background="{Binding ColorBarra}" Margin="0,0,10,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Nombre}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="lblTituloProyeccionLateral" Text="Proyección" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="lblProyGastos" DockPanel.Dock="Right" FontWeight="Bold"/>
                        <TextBlock Text="Gastos" Foreground="{StaticResource Texto2}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="lblProyBalance" DockPanel.Dock="Right" FontWeight="Bold"/>
                        <TextBlock Text="Balance" Foreground="{StaticResource Texto2}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>
  </Grid>
</UserControl>
