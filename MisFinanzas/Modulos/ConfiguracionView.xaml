<!-- Cuenta: nómina, avisos y reglas, conexión con el celular y versión de la app -->
<UserControl x:Class="MisFinanzas.Modulos.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MisFinanzas.Controles">
  <UserControl.Resources>
    <!-- Paso numerado de la conexión del celular -->
    <Style x:Key="NumeroPaso" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource Oscuro}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <!-- Opción de tema: tarjeta con muestra; la elegida con borde de acento -->
    <Style x:Key="OpcionTema" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Borde}" Background="{StaticResource Tarjeta}" Padding="6,8">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource GrisSuave}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AzulSuave}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Azul}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TextoNumeroPaso" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource T_T_FFFFFF}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ScrollPagina.Activo="True">
      <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO + VERSIÓN ===== -->
        <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Background="{StaticResource T_F_FFFFFF}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="12"
                    Padding="14,6" MinHeight="46" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Texto2}" VerticalAlignment="Center">
                        <Run Text="Versión"/> <Run Text="{Binding VersionInstalada, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Texto}"/>
                    </TextBlock>
                    <TextBlock x:Name="lblEstadoVersion" FontSize="12.5" Foreground="{StaticResource Texto2}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Button x:Name="btnDescargar" Content="Descargar" Click="Descargar_Click" Style="{StaticResource BotonAzul}"
                            Height="32" Padding="14,0" FontSize="12.5" Margin="12,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Cuenta" Style="{StaticResource TituloPagina}"/>
                <TextBlock Text="Tu nómina, tus avisos y tu celular" Style="{StaticResource SubtituloPagina}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== NÓMINA + AVISOS ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <c:NominaView x:Name="nomina" SoloConfiguracion="True"/>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Avisos y reglas" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource LineaTabla}" BorderThickness="0,1,0,0" Padding="0,10">
                        <DockPanel>
                            <CheckBox x:Name="chkRecordarPagos" DockPanel.Dock="Right" Style="{StaticResource Interruptor}" VerticalAlignment="Center"
                                      Click="Preferencia_Click" AutomationProperties.Name="Recordarme los pagos"/>
                            <StackPanel>
                                <TextBlock Text="Recordarme los pagos" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="lblDiasAviso" FontSize="12" Foreground="{StaticResource Texto2}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource LineaTabla}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <DockPanel>
                            <CheckBox x:Name="chkVencidosAlAbrir" DockPanel.Dock="Right" Style="{StaticResource Interruptor}" VerticalAlignment="Center"
                                      Click="Preferencia_Click" AutomationProperties.Name="Mostrar vencidos al abrir"/>
                            <StackPanel>
                                <TextBlock Text="Mostrar vencidos al abrir" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Aviso con las cuentas atrasadas" FontSize="12" Foreground="{StaticResource Texto2}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tema de colores: se aplica al reiniciar la app -->
                    <Border Style="{StaticResource LineaTabla}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Tema" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="temaClaro" Tag="Claro" GroupName="Tema" Style="{StaticResource OpcionTema}" Checked="Tema_Checked" Margin="0,0,6,0"
                                             AutomationProperties.Name="Tema claro">
                                    <StackPanel>
                                        <Border Width="46" Height="30" CornerRadius="7" Background="#F2F4F7" BorderBrush="#D5DBE4" BorderThickness="1" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                                                <Border Width="18" Height="9" CornerRadius="3" Background="#FFFFFF"/><Border Width="9" Height="9" CornerRadius="4.5" Background="#1D5BD8" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Claro" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="temaOscuro" Tag="Oscuro" GroupName="Tema" Style="{StaticResource OpcionTema}" Checked="Tema_Checked" Margin="3,0,3,0"
                                             AutomationProperties.Name="Tema oscuro">
                                    <StackPanel>
                                        <Border Width="46" Height="30" CornerRadius="7" Background="#0B1220" BorderBrush="#34425B" BorderThickness="1" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                                                <Border Width="18" Height="9" CornerRadius="3" Background="#141C2B"/><Border Width="9" Height="9" CornerRadius="4.5" Background="#4C84FF" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Oscuro" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="temaRosado" Tag="Rosado" GroupName="Tema" Style="{StaticResource OpcionTema}" Checked="Tema_Checked" Margin="6,0,0,0"
                                             AutomationProperties.Name="Tema rosado">
                                    <StackPanel>
                                        <Border Width="46" Height="30" CornerRadius="7" Background="#FFF4F8" BorderBrush="#EBC3D7" BorderThickness="1" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                                                <Border Width="18" Height="9" CornerRadius="3" Background="#FFFFFF"/><Border Width="9" Height="9" CornerRadius="4.5" Background="#D6338A" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Rosado" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <DockPanel x:Name="pnlReiniciarTema" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Content="Reiniciar ahora" Click="ReiniciarTema_Click" Style="{StaticResource BotonAzul}" Height="32" Padding="12,0" FontSize="12.5"/>
                                <TextBlock Text="El tema se aplica al reiniciar la app." FontSize="12" Foreground="{StaticResource Texto2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== CONECTAR TU CELULAR ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{StaticResource VerdeSuave}" Margin="0,0,12,0">
                        <c:Icono Geometria="{StaticResource IcoCelular}" Tamano="16" Foreground="{StaticResource Verde}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Conectar tu celular" Style="{StaticResource TituloTarjeta}"/>
                        <TextBlock Text="Registra gastos desde el celular y llegan solos a este PC" FontSize="12.5" Foreground="{StaticResource Texto2}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel>
                    <!-- Código QR con el enlace de la app -->
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,18,0">
                        <Border Background="{StaticResource T_F_FFFFFF}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Image x:Name="imgQr" Width="156" Height="156" RenderOptions.EdgeMode="Aliased"
                                   AutomationProperties.Name="Código QR para descargar la app del celular"/>
                        </Border>
                        <TextBlock Text="Escanéalo con la cámara" FontSize="11.5" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Left" Style="{StaticResource NumeroPaso}"><TextBlock Text="1" Style="{StaticResource TextoNumeroPaso}"/></Border>
                            <TextBlock FontSize="13" TextWrapping="Wrap"><Run Text="Abre la"/> <Run Text="cámara" FontWeight="Bold"/> <Run Text="de tu celular y apunta al código."/></TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Left" Style="{StaticResource NumeroPaso}"><TextBlock Text="2" Style="{StaticResource TextoNumeroPaso}"/></Border>
                            <TextBlock FontSize="13" TextWrapping="Wrap"><Run Text="Toca el enlace y"/> <Run Text="descarga la app" FontWeight="Bold"/><Run Text="."/></TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Style="{StaticResource NumeroPaso}"><TextBlock Text="3" Style="{StaticResource TextoNumeroPaso}"/></Border>
                            <TextBlock FontSize="13" TextWrapping="Wrap"><Run Text="Ábrela y entra con la misma cuenta de este PC para"/> <Run Text="vincularla" FontWeight="Bold"/><Run Text="."/></TextBlock>
                        </DockPanel>
                        <Border Background="{StaticResource GrisSuave}" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="10" Padding="12,6,6,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Copiar" Click="CopiarEnlace_Click" Style="{StaticResource BotonSecundario}"
                                        Height="30" Padding="12,0" FontSize="12.5" AutomationProperties.Name="Copiar enlace de descarga"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource Texto2}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0">
                                    <Run Text="¿Sin cámara? Abre"/>
                                    <Hyperlink x:Name="lnkEnlace" Click="AbrirEnlaceApp_Click" Foreground="{StaticResource Azul}" FontWeight="SemiBold"
                                               AutomationProperties.Name="Abrir la app del celular"><Run x:Name="runEnlace"/></Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource LineaTabla}" Margin="0,14,0,12"/>
                <TextBlock Text="CELULARES CONECTADOS" Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,8"/>

                <!-- Conectado: estado y desconectar -->
                <Border x:Name="pnlConectado" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="10" Padding="10,8" Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{StaticResource GrisSuave}" Margin="0,0,10,0">
                            <c:Icono Geometria="{StaticResource IcoCelular}" Tamano="15" Foreground="{StaticResource Texto2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="Desconectar" Click="BtnDesconectar_Click" Style="{StaticResource BotonPeligro}"
                                Height="32" Padding="14,0" FontSize="12.5" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="{StaticResource VerdeSuave}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource T_A_12B76A}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Conectado" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource VerdeTexto}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblCuentaCelular" Text="Tu celular" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="lblEstadoCelular" FontSize="12" Foreground="{StaticResource Texto2}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Sin conectar: entrar o crear la cuenta que comparten el PC y el celular -->
                <StackPanel x:Name="pnlConectar" Visibility="Collapsed">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Aún no hay un celular vinculado. Entra con la cuenta que usas (o usarás) en la app del celular; los gastos que registres allá llegan aquí aunque el PC haya estado apagado."/>
                    <WrapPanel>
                        <StackPanel Width="230" Margin="0,0,10,8">
                            <Label Content="Correo" Target="{Binding ElementName=txtCorreo}" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtCorreo" Style="{StaticResource ModernInput}"/>
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,10,8">
                            <Label Content="Contraseña" Target="{Binding ElementName=txtClave}" Style="{StaticResource Etiqueta}"/>
                            <PasswordBox x:Name="txtClave" Height="44" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                         BorderBrush="{StaticResource BordeInput}" BorderThickness="1"/>
                        </StackPanel>
                        <Button x:Name="btnConectar" Content="Conectar" Click="BtnConectar_Click" Style="{StaticResource BotonAzul}"
                                c:Ui.Icono="{StaticResource IcoCheck}" VerticalAlignment="Bottom" Margin="0,0,0,8" IsDefault="False"/>
                    </WrapPanel>
                    <CheckBox x:Name="chkCrearCuenta" Content="Es la primera vez: crear la cuenta" Style="{StaticResource ModernCheckBox}"/>
                    <TextBlock x:Name="lblErrorCelular" Foreground="{StaticResource Rojo}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>
  </Grid>
</UserControl>
