<UserControl x:Class="MisFinanzas.Modulos.DetalleVehiculoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:controles="clr-namespace:MisFinanzas.Controles"
             Background="#F0F2F5">

    <UserControl.Resources>
        <!-- Texto plano visible solo en modo lectura -->
        <Style x:Key="ViewStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editando}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Botón redondo pequeño para acciones (editar/guardar/eliminar) -->
        <Style x:Key="RoundActionButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" controles:ScrollPagina.Activo="True">
    <Grid Margin="18,12,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con botón regresar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Click="BtnRegresar_Click" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,15,0"
                        Width="40" Height="40" Background="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.1" ShadowDepth="2"/>
                    </Button.Effect>
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4A90E2"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource PageTitle}"/>
                        <Border Background="#EDF2F7" CornerRadius="6" Padding="10,3" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Placa}" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                        </Border>
                    </StackPanel>
                    <Rectangle Height="4" Width="60" Fill="#3498DB" HorizontalAlignment="Left" Margin="2,5,0,0" RadiusX="2" RadiusY="2"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Tarjeta del formulario -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3498DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar inversión o pago" FontSize="15" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPCIÓN (REPUESTO O PAGO)" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="txtConcepto" Style="{StaticResource ModernInput}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="VALOR ($)" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" x:Name="txtValor" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True"/>

                    <Button Grid.Row="1" Grid.Column="4" Content="REGISTRAR" Click="BtnAgregarGasto_Click"
                            Style="{StaticResource PrimaryButton}" Background="#3498DB" MinWidth="130"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Historial -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="HISTORIAL DE INVERSIÓN Y PAGOS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Concepto" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Fecha" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Valor" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="Acciones" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icRepuestos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Margin="0,4" Padding="12,10" BorderThickness="1" HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#EDF2F7"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editando}" Value="True">
                                                    <Setter Property="Background" Value="#F7FBFF"/>
                                                    <Setter Property="BorderBrush" Value="#BEE3F8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Concepto: texto plano / input -->
                                        <TextBlock Grid.Column="0" Text="{Binding Concepto}" FontSize="14" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" Style="{StaticResource ViewStyle}"/>
                                        <TextBox   Grid.Column="0" Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,10,0" Style="{StaticResource EditInputInline}"/>

                                        <!-- Fecha (chip, solo lectura) -->
                                        <Border Grid.Column="1" Background="#EDF2F7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Fecha, StringFormat=d}" FontSize="12" Foreground="#718096"/>
                                        </Border>

                                        <!-- Valor: texto plano / input -->
                                        <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:C0}'}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource ViewStyle}"/>
                                        <TextBox   Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" Style="{StaticResource EditInputInline}"/>

                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Editar/Guardar (alterna) -->
                                            <Button Click="BtnToggleEdicionGasto_Click" Margin="2,0" ToolTip="Editar">
                                                <Button.Content>
                                                    <TextBlock FontSize="14">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✎"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                                                        <Setter Property="Text" Value="✔"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RoundActionButton}">
                                                        <Setter Property="Background" Value="#3498DB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Editando}" Value="True">
                                                                <Setter Property="Background" Value="#27AE60"/>
                                                                <Setter Property="ToolTip" Value="Guardar cambios"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Eliminar (se oculta al editar) -->
                                            <Button Content="✕" Click="BtnEliminarGasto_Click" Margin="2,0" ToolTip="Eliminar">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RoundActionButton}">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Editando}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>

    <controles:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== MODAL DE CONFIRMACIÓN DE ELIMINACIÓN ===== -->
    <Grid x:Name="OverlayConfirm" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="400" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" Opacity="0.3" ShadowDepth="6"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="56" Height="56" Background="#FFF5F5" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E53E3E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Eliminar registro" FontSize="18" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                <TextBlock FontSize="13" Foreground="#718096" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22">
                    <Run Text="¿Seguro que deseas eliminar "/><Run x:Name="runNombreGasto" FontWeight="Bold" Foreground="#2D3748"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Click="ConfirmCancelar_Click"
                            Height="42" Cursor="Hand" Foreground="#4A5568" FontWeight="SemiBold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#EDF2F7" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Eliminar" Click="ConfirmEliminar_Click"
                            Height="42" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#E53E3E" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#C53030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
