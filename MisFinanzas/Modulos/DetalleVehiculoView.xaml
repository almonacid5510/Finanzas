<!-- Detalle de un vehículo: se muestra dentro de la pantalla de Vehículos (panel derecho) -->
<UserControl x:Class="MisFinanzas.Modulos.DetalleVehiculoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MisFinanzas"
             xmlns:c="clr-namespace:MisFinanzas.Controles">

    <UserControl.Resources>
        <Style x:Key="ViewStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editando}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

  <Grid>
    <StackPanel>
        <!-- Indicadores -->
        <c:GrillaAdaptable Columnas="3" AnchoMinimo="160" Espacio="10" Margin="0,0,0,14">
            <Border Style="{StaticResource Recuadro}" Background="{StaticResource AzulSuave}">
                <StackPanel>
                    <TextBlock Text="INVERSIÓN TOTAL" Style="{StaticResource EtiquetaSeccion}" FontSize="11.5" Foreground="#1D4FB8"/>
                    <TextBlock Text="{Binding TotalInvertido, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Azul}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Recuadro}">
                <StackPanel>
                    <TextBlock Text="REGISTROS" Style="{StaticResource EtiquetaSeccion}" FontSize="11.5"/>
                    <TextBlock Text="{Binding Registros}" FontSize="22" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Recuadro}">
                <StackPanel>
                    <TextBlock Text="ÚLTIMO GASTO" Style="{StaticResource EtiquetaSeccion}" FontSize="11.5"/>
                    <TextBlock Text="{Binding UltimoGasto}" FontSize="22" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </c:GrillaAdaptable>

        <!-- Registrar un gasto en una fila -->
        <Border Style="{StaticResource Recuadro}" Padding="14,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.55*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Repuesto o pago" Target="{Binding ElementName=txtConcepto}" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="1" x:Name="txtConcepto" Style="{StaticResource ModernInput}" c:Ui.Pista="Ej. SOAT, cambio de aceite"/>
                <Label Grid.Column="2" Content="Valor" Target="{Binding ElementName=txtValor}" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtValor" Style="{StaticResource ModernInputNumeric}" local:NumeroHelper.EsMoneda="True" c:Ui.Pista="$ 0"/>
                <Label Grid.Column="4" Content="Fecha" Target="{Binding ElementName=dpFecha}" Style="{StaticResource Etiqueta}"/>
                <DatePicker Grid.Row="1" Grid.Column="4" x:Name="dpFecha" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short"
                            ToolTip="Si la dejas vacía se usa la fecha de hoy"/>
                <Button Grid.Row="1" Grid.Column="6" Content="Registrar" Click="BtnAgregarGasto_Click" Style="{StaticResource BotonAzul}"
                        c:Ui.Icono="{StaticResource IcoPlus}"/>
            </Grid>
        </Border>

        <!-- Historial -->
        <TextBlock Text="HISTORIAL DE INVERSIÓN Y PAGOS" Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,10"/>
        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="88"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Concepto" Style="{StaticResource EncabezadoTabla}"/>
            <TextBlock Grid.Column="1" Text="Fecha" Style="{StaticResource EncabezadoTabla}"/>
            <TextBlock Grid.Column="2" Text="Valor" Style="{StaticResource EncabezadoTabla}" HorizontalAlignment="Right"/>
        </Grid>
        <Border Style="{StaticResource LineaTabla}"/>
        <TextBlock x:Name="lblSinRegistros" Text="Aún no hay registros para este vehículo." Style="{StaticResource TextoSecundario}" Margin="8,12" Visibility="Collapsed"/>
        <ItemsControl x:Name="icRepuestos">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource LineaTabla}" Padding="8,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Concepto}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource ViewStyle}"/>
                            <TextBox Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" Style="{StaticResource EditInputInline}" Margin="0,0,10,0"
                                     AutomationProperties.Name="Concepto"/>
                            <TextBlock Grid.Column="1" Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="{StaticResource Texto2}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:$&#160;#,##0;-$&#160;#,##0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Azul}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ViewStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:N0}', UpdateSourceTrigger=LostFocus}" Style="{StaticResource EditInputInline}"
                                     TextAlignment="Right" AutomationProperties.Name="Valor"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Click="BtnToggleEdicionGasto_Click" AutomationProperties.Name="Editar registro" ToolTip="Editar registro">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotonIcono}">
                                            <Setter Property="c:Ui.Icono" Value="{StaticResource IcoEditar}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editando}" Value="True">
                                                    <Setter Property="c:Ui.Icono" Value="{StaticResource IcoCheck}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Verde}"/>
                                                    <Setter Property="ToolTip" Value="Guardar cambios"/>
                                                    <Setter Property="AutomationProperties.Name" Value="Guardar cambios"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Click="BtnEliminarGasto_Click" Style="{StaticResource BotonIconoPeligro}" c:Ui.Icono="{StaticResource IcoEliminar}"
                                        Margin="6,0,0,0" AutomationProperties.Name="Eliminar registro" ToolTip="Eliminar registro"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

    <c:Toast x:Name="toast" Panel.ZIndex="50"/>

    <!-- ===== CONFIRMACIÓN DE ELIMINACIÓN DE UN REGISTRO ===== -->
    <Grid x:Name="OverlayConfirm" Background="#990F1B2D" Visibility="Collapsed" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Eliminar registro" FontSize="17" FontWeight="Bold"/>
                <TextBlock FontSize="13.5" Foreground="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,6,0,18">
                    <Run Text="¿Seguro que deseas eliminar "/><Run x:Name="runNombreGasto" FontWeight="Bold" Foreground="{StaticResource Texto}"/><Run Text="? Esta acción no se puede deshacer."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="ConfirmCancelar_Click" Style="{StaticResource BotonSecundario}" IsCancel="True"/>
                    <Button Content="Eliminar" Click="ConfirmEliminar_Click" Style="{StaticResource Boton}" Background="{StaticResource Rojo}"
                            c:Ui.Icono="{StaticResource IcoEliminar}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
