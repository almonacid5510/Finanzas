<Window x:Class="MisFinanzas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MisFinanzas"
        xmlns:c="clr-namespace:MisFinanzas.Controles"
        Title="Gestor de Finanzas Personal" Height="800" Width="1360" MinWidth="900" MinHeight="560"
        Background="{StaticResource Fondo}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FuenteApp}" FontSize="13" Foreground="{StaticResource Texto}"
        Typography.NumeralAlignment="Tabular"
        TextOptions.TextFormattingMode="Display"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Ítem del menú lateral: ícono (Tag) + nombre. El activo se marca con local:NavState.IsActive -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextoMenu}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,0">
                            <DockPanel>
                                <c:Icono DockPanel.Dock="Left" Geometria="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Tamano="18" Foreground="{TemplateBinding Foreground}" Margin="0,0,13,0"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2A40"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2A40"/>
                            </Trigger>
                            <Trigger Property="local:NavState.IsActive" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource OscuroActivo}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Raíz con zoom: el diseño se dibuja a 1430 de ancho y se reduce si la ventana es más angosta -->
    <Grid x:Name="Raiz">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ MENÚ LATERAL ============ -->
        <Border Background="{StaticResource Oscuro}">
            <DockPanel Margin="14,22,14,18">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Verde}">
                        <c:Icono Geometria="{StaticResource IcoLogo}" Tamano="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mis Finanzas" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Gestor personal" FontSize="12" Foreground="#9AA6B6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pie: autoría -->
                <TextBlock DockPanel.Dock="Bottom" Text="© 2026 Juan Almonacid" FontSize="12" Foreground="#9AA6B6" Margin="6,0,0,0"/>

                <StackPanel>
                    <Button x:Name="btnNavDashboard" Content="Dashboard" Tag="{StaticResource IcoDashboard}"
                            Click="NavDashboard_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavIngresos" Content="Ingresos y ahorro" Tag="{StaticResource IcoIngresos}"
                            Click="NavIngresos_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavCuentas" Tag="{StaticResource IcoCuentas}" AutomationProperties.Name="Cuentas"
                            Click="NavCuentas_Click" Style="{StaticResource NavButtonStyle}">
                        <DockPanel>
                            <!-- Contador de pagos vencidos -->
                            <Border x:Name="insigniaVencidas" DockPanel.Dock="Right" Background="#D92D20" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="lblVencidas" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cuentas" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button x:Name="btnNavCreditos" Content="Créditos" Tag="{StaticResource IcoCreditos}"
                            Click="NavCreditos_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavVehiculo" Content="Vehículos" Tag="{StaticResource IcoVehiculos}"
                            Click="NavVehiculo_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavNegocio" Content="Inversiones" Tag="{StaticResource IcoInversiones}"
                            Click="NavNegocio_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENIDO ============ -->
        <ContentControl x:Name="ContenedorPrincipal" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
