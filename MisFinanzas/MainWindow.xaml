<Window x:Class="MisFinanzas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Finanzas Personal" Height="650" Width="1100" 
        Background="#F4F7F9" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10,30,10,10">
                <TextBlock Text="MIS FINANZAS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="Dashboard" Click="NavDashboard_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
                <Button Content="Ingresos" Click="NavIngresos_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
                <Button Content="Cuentas" Click="NavCuentas_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
                <Button Content="Créditos" Click="NavCreditos_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
                <Button Content="Vehiculos" Click="NavVehiculo_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
                <Button Content="Inversiones" Click="NavNegocio_Click" Margin="0,5" Height="40" Background="#34495E" Foreground="White" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContenedorPrincipal" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>