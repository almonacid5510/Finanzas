<Window x:Class="MisFinanzas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MisFinanzas"
        xmlns:c="clr-namespace:MisFinanzas.Controles"
        Title="Gestor de Finanzas Personal" Height="800" Width="1360" MinWidth="900" MinHeight="560"
        Background="{StaticResource Fondo}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FuenteApp}" FontSize="13" Foreground="{StaticResource Texto}"
        Typography.NumeralAlignment="Tabular"
        TextOptions.TextFormattingMode="Display"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Ítem del menú lateral: ícono (Tag) + nombre. El activo se marca con local:NavState.IsActive -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextoMenu}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- El fondo sigue el ancho del menú; el contenido tiene ancho fijo y se recorta al cerrarlo -->
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="15,0" ClipToBounds="True">
                            <DockPanel Width="160" HorizontalAlignment="Left">
                                <Grid DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <c:Icono Geometria="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                             Tamano="18" Foreground="{TemplateBinding Foreground}"/>
                                    <!-- Punto rojo de pendientes: solo con el menú cerrado (abierto se ve el contador) -->
                                    <Ellipse x:Name="punto" Width="9" Height="9" Fill="#F04438" Stroke="{StaticResource Oscuro}" StrokeThickness="1.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" Visibility="Collapsed"
                                             Opacity="{Binding Opacity, ElementName=refCerrado}"/>
                                </Grid>
                                <!-- El nombre aparece al desplegar el menú -->
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                  Opacity="{Binding Opacity, ElementName=panelNombreApp}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:NavState.TieneAlerta" Value="True">
                                <Setter TargetName="punto" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2A40"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2A40"/>
                            </Trigger>
                            <Trigger Property="local:NavState.IsActive" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource OscuroActivo}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Raíz con zoom: el diseño se dibuja a 1430 de ancho y se reduce si la ventana es más angosta -->
    <Grid x:Name="Raiz">
        <Grid.ColumnDefinitions>
            <!-- Espacio del menú cerrado; al desplegarse pasa por encima del contenido -->
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Opacidad que se anima al revés que los nombres (1 = menú cerrado) -->
        <Rectangle x:Name="refCerrado" Visibility="Hidden" Width="0" Opacity="1"/>

        <!-- ============ MENÚ LATERAL DESPLEGABLE ============ -->
        <Border x:Name="Sidebar" Grid.ColumnSpan="2" Width="68" HorizontalAlignment="Left" Panel.ZIndex="100"
                Background="{StaticResource Oscuro}" ClipToBounds="True"
                MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
            <Border.Effect>
                <DropShadowEffect x:Name="sombraMenu" BlurRadius="24" Direction="0" Opacity="0" ShadowDepth="4"/>
            </Border.Effect>
            <DockPanel Margin="10,22,10,18">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Verde}">
                        <c:Icono Geometria="{StaticResource IcoLogo}" Tamano="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="panelNombreApp" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0">
                        <TextBlock Text="Mis Finanzas" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Gestor personal" FontSize="12" Foreground="#9AA6B6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pie: autoría -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <TextBlock Text="©" FontSize="13" Foreground="#9AA6B6" Width="48" TextAlignment="Center"/>
                    <TextBlock Text="2026 Juan Almonacid" FontSize="12" Foreground="#9AA6B6" VerticalAlignment="Center"
                               Opacity="{Binding Opacity, ElementName=panelNombreApp}"/>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="btnNavDashboard" Content="Dashboard" ToolTip="Dashboard" Tag="{StaticResource IcoDashboard}"
                            Click="NavDashboard_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavIngresos" Content="Ingresos y ahorro" ToolTip="Ingresos y ahorro" Tag="{StaticResource IcoIngresos}"
                            Click="NavIngresos_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavCuentas" Tag="{StaticResource IcoCuentas}" AutomationProperties.Name="Cuentas"
                            Click="NavCuentas_Click" Style="{StaticResource NavButtonStyle}">
                        <DockPanel>
                            <!-- Contador de pagos vencidos -->
                            <Border x:Name="insigniaVencidas" DockPanel.Dock="Right" Background="#D92D20" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="lblVencidas" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cuentas" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button x:Name="btnNavCreditos" Content="Créditos" ToolTip="Créditos" Tag="{StaticResource IcoCreditos}"
                            Click="NavCreditos_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavVehiculo" Content="Vehículos" ToolTip="Vehículos" Tag="{StaticResource IcoVehiculos}"
                            Click="NavVehiculo_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="btnNavNegocio" Content="Inversiones" ToolTip="Inversiones" Tag="{StaticResource IcoInversiones}"
                            Click="NavNegocio_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENIDO ============ -->
        <ContentControl x:Name="ContenedorPrincipal" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
